  classical
  let _ : Submodule.IsFullLattice E N := hN
  obtain ⟨s, hs⟩ := Submodule.IsLattice.fg E N
  obtain ⟨d1, hd1, h1⟩ := commens_denoms (s.biUnion fun x => Finset.univ.image x)
