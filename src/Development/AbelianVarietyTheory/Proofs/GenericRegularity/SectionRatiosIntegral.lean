theorem section_ratios_integral : ∀ (D : D7) (T : Top D) (h : LawsP T) (j : ℕ) (hj : InR D j) (hG : GenFrEx (T.Q.Xo j) T.Q.c) (_ : GenFromTest (T.Q.Xo j) T.Q.c hG) (ka wL wF : WeightFamilies.Wt D j) (G : GlobalFamilyData (recPlus h j hj) ka wL wF) (S : Scal (recB h.toLawsCore)) (g0 : (recB h.toLawsCore).Cusp j wF) (la : HeightOneSpectrum (𝓞 (recB h.toLawsCore).KO)), CurveHyp h j hj hG ka wL wF G S g0 → GenValInjSt h j hG → CompSplitSt h j hG → BIRSt h j hj hG G → Nonempty (CurveModel (E := extAll h j hj) (hM := intAtExt_extAll h j hj) G la g0) → GenericSectionMinimumIntegral (E := extAll h j hj) (hM := intAtExt_extAll h j hj) G la := by
  intro D T h j hj hG _ ka wL wF G S g0 la _ _ _ _ _
  exact Formalism.L2.Pj.GenericSectionMinimum.generic_section_minimum_integral (E := extAll h j hj) (hM := intAtExt_extAll h j hj) G la

