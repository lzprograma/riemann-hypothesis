  let ψ2 : Ideles E →* Gab E Ω ⧸ U := χ.comp art
  have ho2 : IsOpen (ψ2.ker : Set (Ideles E)) :=
    (show (ψ2.ker : Set (Ideles E)) = art ⁻¹' U by ext x; simp [ψ2, χ, QuotientGroup.eq_one_iff]) ▸
      hU.preimage ha.quot.continuous
  obtain ⟨SE, ME, hvS, -, hSc⟩ := _root_.GlobalTheory.OpenIdeleCongr.open_subgroup_contains_congr E ψ2.ker ho2 {v}
  obtain ⟨ML, hML⟩ := _root_.GlobalTheory.NormCompat.NormCont.norm_close_to_one E K v ME
  have h := _root_.GlobalTheory.LocNormGrp.chi_locUnit_eq_chi_locUnit_norm E K Ω
    (fun x => IsScalarTower.algebraMap_apply E K Ω x) v W hW art artK ha haK ρ (continuous_liftAb r hr)
    (fun τ' σ' hσ' => by have : σ' = τ'.restrictScalars E := AlgEquiv.ext hσ'; subst this; rfl) U hU
    ⟨ML, fun z hz => MonoidHom.mem_ker.mp (hSc v (hvS (Finset.mem_singleton_self v)) _
      (hML (z : K) fun w hw => hWu w hw ▸ hz))⟩ y
  exact (QuotientGroup.eq_one_iff _).mp (by
    show χ (ρ (artK (locUnit K W y)) / art (locUnit E v (Units.map (Algebra.norm E (S := K)) y))) = 1
    rw [map_div, h, div_self'])

end GlobalTheory.NormCompat
