      rw [mul_pow (r : ℝ)]
      gcongr
    have hκb := hbd Hm hH'
    rw [inv_inv, ← Fintype.card_coe, QuadraticCoefficientForms.card_Psi] at hκb
    replace hκb := hκb.trans (const_le r hLa hT hC hCT a' n _ (fun τ i => mul_nonneg Real.pi_pos.le (by
      rw [← herm_single Hm]
