    (cB : Matrix (Fin W₁.rank) (Fin (W.rank + W₁.rank)) (AE D) ≃+ WO W₁ X),
    IsInfFam θ → IsTriple W W₁ X α β → IsOver ψ θ A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB →
    GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.IsTriple Bs Γ Xc om om' →
    ∀ Pi rf rl p p', IsMatch ψ θ A A₁ B α β ωA ωB Pi rf rl p p' →
    ∀ γ ∈ GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Lines D.sp.cm.sig Γ.W, ∀ Φ ∈ kerPD ψ θ A₁ B Bs Γ cB p', ∀ Φ₁ ∈ algD Γ.M' Bs.ψ Bs.emb, (∀ x, HasDerivAt (fun t : ℝ => om' (1, γ (Multiplicative.ofAdd t)) Φ x) (Φ₁ x) 0) → Φ₁ ∈ kerPD ψ θ A₁ B Bs Γ cB p' := by
  intro hP D ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT Pi rf rl p p' hm γ hγ ΦD hΦD Φ₁D hΦ₁D hder
  have hψ : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.IsStd ψ := hO.psi ▸ hT.base.std
  obtain ⟨hΦD', Φ, -, hD, hp⟩ := (mem_kerPD hψ θ A₁ B Bs Γ cB p' ΦD).1 hΦD
  obtain ⟨Φ₁, hΦ₁F, hD₁⟩ := hO.algB' Φ₁D hΦ₁D
  refine (mem_kerPD hψ θ A₁ B Bs Γ cB p' Φ₁D).2 ⟨hΦ₁D, Φ₁, hΦ₁F, hD₁, ?_⟩
  exact GlobalTheory.LineDerivCore.ker_projection_eq_line_weyl_core D ψ θ W₁ X A₁ B false e Bs Γ.W Γ.V' Γ.M' om' ωB cB
    hO.JX hθ hψ hO.algB'
    (_root_.GlobalTheory.LineSumV'.lineSum_derivative_sum hP D θ X e Bs Γ Xc om om' hO.JX hθ hT)
    (_root_.GlobalTheory.SquareAgree.LineDerFunB.lineDerivation_isDerivation_of_datum hP D ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT)
    rl p' hm.mapB.eql
    γ hγ ΦD hΦD' Φ₁D hder Φ Φ₁ hD hD₁ hp

