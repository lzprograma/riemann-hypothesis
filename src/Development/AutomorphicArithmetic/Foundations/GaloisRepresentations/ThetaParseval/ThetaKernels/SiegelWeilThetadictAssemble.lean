theorem exists_standard_hermitian_space {B : Base F E} (hB : GoodK σ B) {n : ℕ} (hn : 1 ≤ n) :
    ∃ (Y₀ : Spc F E n) (b₀ : GL (Fin n ⊕ Fin n) E) (K₀ : Subgroup (G2 σ Y₀)) (a₀ : G2 σ Y₀ → ℝ),
      IsFrame2 σ Y₀ b₀ ∧ b₀.1ᵀ * dbl Y₀.J * b₀.1.map σ = Ald.jeps n 1 ∧
      IsStdK (σ := σ) (Y := Y₀) B b₀ K₀ ∧ IsHgt K₀ a₀ := by
  obtain ⟨b, K, a, hb, hK, ha, -, -⟩ :=
    stdEx_of_k frameConj_k hgtEx_k F
      E σ B n (UnitHermitianSpace.unitSpc F E n) n 0 hB (Or.inl
      (UnitHermitianSpace.isHerm_unitSpc_k hB n))
  refine ⟨UnitHermitianSpace.unitSpc F E n, b, K, a, hb, ?_, hK, ha⟩
  obtain ⟨ε, hε⟩ := hb.1
  have hc : ∀ z : E, σ (σ z) = z := (UnitHermitianSpace.isHerm_unitSpc_k
    hB n).herm |> fun _ => by
    intro z
    obtain ⟨τ⟩ : Nonempty (E →+* ℂ) := inferInstance
    exact τ.injective (by rw [hB.cm.2.2.2, hB.cm.2.2.2, star_star])
  have h1 := eps_one hn hc (UnitHermitianSpace.isHerm_unitSpc_k hB
    n).herm hε
  rw [hε, eps_unit h1]
  simp [Ald.jeps]
end PositivityTheory.SiegelWeilFormula.Ldexb
