private theorem cpow_integral_pk {Y : Type} [MeasurableSpace Y] {μ : Measure Y} {A : Y → ℝ} {b : Y → ℂ} {t₀ q C : ℝ}
    (h0 : ∀ x, 0 < A x) (mA : Measurable A) (mb : AEStronglyMeasurable b μ) (hb : ∀ x, ‖b x‖ ≤ C * A x ^ q)
    (hi : ∀ t, t₀ ≤ t → Integrable (fun x => A x ^ t) μ) (s₀ : ℂ) :
    (∀ z : ℂ, t₀ < z.re - s₀.re + q → Integrable (fun x => (A x : ℂ) ^ (z - s₀) * b x) μ) ∧
      DifferentiableOn ℂ (fun z => ∫ x, (A x : ℂ) ^ (z - s₀) * b x ∂μ) {z : ℂ | t₀ < z.re - s₀.re + q} := by
  have mz : ∀ z : ℂ, AEStronglyMeasurable (fun x => (A x : ℂ) ^ (z - s₀) * b x) μ := fun z =>
    ((Complex.measurable_ofReal.comp mA).pow_const _).aestronglyMeasurable.mul mb
  have nz : ∀ (z : ℂ) x, ‖(A x : ℂ) ^ (z - s₀) * b x‖ ≤ |C| * A x ^ (z.re - s₀.re + q) := fun z x => by
    have p := h0 x
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos p, Complex.sub_re, Real.rpow_add p, mul_left_comm]
    exact mul_le_mul_of_nonneg_left ((hb x).trans (mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg p.le
      _)))
      (Real.rpow_nonneg p.le _)
  refine ⟨fun z hz => ((hi _ hz.le).const_mul |C|).mono' (mz z) (.of_forall (nz z)),
    GroundTheory.Automorphic.PseudoEisenstein.differentiableOn_integral_of_bound
      (isOpen_lt continuous_const (by fun_prop))
      (fun x _ _ => (DifferentiableAt.const_cpow (by fun_prop)
        (Or.inl (Complex.ofReal_ne_zero.2 (h0 x).ne'))).mul_const _ |>.differentiableWithinAt)
      (fun z _ => mz z) fun z hz => ?_⟩
  have hz' : t₀ < z.re - s₀.re + q := hz
  set u := z.re - s₀.re + q
  refine ⟨(u - t₀) / 2, by linarith, fun w hw => ?_,
    fun x => |C| * (A x ^ (u - (u - t₀) / 2) + A x ^ (u + (u - t₀) / 2)),
    (((hi _ (by linarith)).add (hi _ (by linarith))).const_mul _), fun w hw x => ?_⟩
  · have := (Complex.abs_re_le_norm (w - z)).trans (mem_closedBall_iff_norm.1 hw)
    rw [Complex.sub_re, abs_le] at this; show t₀ < w.re - s₀.re + q; linarith [this.1]
  · have hb' := (Complex.abs_re_le_norm (w - z)).trans (mem_closedBall_iff_norm.1 hw)
    rw [Complex.sub_re, abs_le] at hb'
    refine (nz w x).trans (mul_le_mul_of_nonneg_left ?_ (abs_nonneg _))
    have p := h0 x
    have := Real.rpow_pos_of_pos p (u - (u - t₀) / 2); have := Real.rpow_pos_of_pos p (u + (u - t₀) / 2)
    rcases le_total 1 (A x) with h | h
    · have := Real.rpow_le_rpow_of_exponent_le h (show w.re - s₀.re + q ≤ u + (u - t₀) / 2 by linarith [hb'.2])
      linarith
    · have := Real.rpow_le_rpow_of_exponent_ge p h (show u - (u - t₀) / 2 ≤ w.re - s₀.re + q by linarith [hb'.1])
      linarith

private theorem coef_facts_pk {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [MeasurableSpace G]
    [BorelSpace G] [SecondCountableTopology G] {μ : Measure G} [μ.IsMulLeftInvariant] [μ.IsMulRightInvariant]
    {Γ : Subgroup G} [Countable Γ] {D : Set G} (hD : IsFundamentalDomain Γ D μ) [IsFiniteMeasure (μ.restrict D)]
    {φ : G → ℂ} (hc : Continuous φ) {C : ℝ} (hb : ∀ g, ‖φ g‖ ≤ C) (hi : ∀ γ ∈ Γ, ∀ g, φ (γ * g) = φ g) :
    Continuous (fun g => pet μ D (fun y => φ (y * g)) φ) ∧ (∃ C' : ℝ, ∀ g, ‖pet μ D (fun y => φ (y * g)) φ‖ ≤ C') ∧
      ∀ g, pet μ D (fun y => φ (y * g⁻¹)) φ = star (pet μ D (fun y => φ (y * g)) φ) := by
  have C0 : 0 ≤ C := (norm_nonneg _).trans (hb 1)
  have nb : ∀ g y, ‖φ (y * g) * star (φ y)‖ ≤ C * C := fun g y => by
    rw [norm_mul, norm_star]; exact mul_le_mul (hb _) (hb _) (norm_nonneg _) C0
  refine ⟨continuous_of_dominated (bound := fun _ => C * C)
      (fun g => (by fun_prop : Continuous fun y => φ (y * g) * star (φ y)).aestronglyMeasurable)
      (fun g => .of_forall (nb g)) (integrable_const _) (.of_forall fun y => by fun_prop),
    ⟨C * C * (μ.restrict D).real Set.univ, fun g => by
      simpa [pet] using norm_integral_le_of_norm_le_const (μ := μ.restrict D) (.of_forall (nb g))⟩,
    fun g => by
      let f : G → ℂ := fun y => φ y * star (φ (y * g))
      have hf : ∀ (γ : Γ) x, f (γ • x) = f x := fun γ x => by
        simp only [f, Subgroup.smul_def, smul_eq_mul, mul_assoc]; rw [hi _ γ.2, hi _ γ.2]
      have h3 : ∫ y in MulOpposite.op g⁻¹ • D, f y ∂μ = ∫ y in D, f (y * g⁻¹) ∂μ :=
        (measurePreserving_mul_right μ g⁻¹).setIntegral_image_emb (measurableEmbedding_mulRight g⁻¹) f D
      have h4 := (hD.smul_of_comm (MulOpposite.op g⁻¹)).setIntegral_eq hD hf
      rw [h3] at h4
      simp only [f, inv_mul_cancel_right] at h4
      simp only [pet]; rw [h4, Complex.star_def, ← integral_conj]
      exact integral_congr_ae (.of_forall fun y => by simp [mul_comm])⟩

private theorem zero_of_half_pk {U : Set ℂ} {τ t : ℝ} {f : ℂ → ℂ} {s : ℂ} (hU : IsOpen U)
    (hd : ∀ z, ∀ᶠ w in 𝓝[≠] z, w ∈ U) (hf : DifferentiableOn ℂ f (U ∩ {z : ℂ | τ < z.re}))
    (ht : ∀ z : ℂ, t < z.re → z ∈ U ∧ f z = 0) (hs : s ∈ U) (hs' : τ < s.re) : f s = 0 := by
  have hsh : Continuous fun z : ℂ => z + (τ : ℂ) := by fun_prop
  have key := eq_zero_of_right (U := (fun z : ℂ => z + (τ : ℂ)) ⁻¹' U) (hU.preimage hsh)
    (fun z => by
      have tt : Tendsto (fun z : ℂ => z + (τ : ℂ)) (𝓝[≠] z) (𝓝[≠] (z + (τ : ℂ))) :=
        tendsto_nhdsWithin_iff.2 ⟨hsh.continuousAt.tendsto.mono_left nhdsWithin_le_nhds,
          eventually_mem_nhdsWithin.mono fun _ hw h => hw (add_right_cancel h)⟩
      exact tt.eventually (hd _))
    (f := fun z => f (z + (τ : ℂ))) (hf.comp (by fun_prop) fun z hz => ⟨hz.1, by simpa using hz.2⟩)
    (t := t - τ) (fun z hz => ⟨(ht _ (by simp; linarith [hz])).1,
      (ht _ (by simp; linarith [hz])).2⟩)
    (s := s - (τ : ℂ)) (by simpa using hs) (by simpa using hs')
  simpa using key

private theorem rallis_k : Tools_k → Rallis_k := by
  intro T F E _ _ _ _ _ σ B n d X W M χX χW om hP hn hd K a e hK ha he t₀ hi hlt ν hν Φ hΦ φ hφ
