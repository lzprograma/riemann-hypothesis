section
private theorem thetaBasic_pk : ThetaBasic_k := by
  open PositivityTheory.ThKF0.Grow PositivityTheory.ThKF0 in
  intro F E _ _ _ _ _ σ B n d X W M χX χW om r s r' s' hP
  have hS := hP.weil.isUSplitting
  obtain ⟨l, hl, hlt⟩ := (_root_.GlobalTheory.CompanionTheory.ThetaAdm.theta_adm F (Fin n × Fin d)).2.1
  refine ⟨fun Φ hΦ => ⟨?_, ?_, ?_⟩, ?_⟩
  · exact (hS.cont l hl Φ hΦ).congr fun x => hlt _ (hS.pres _ _ hΦ)
  · intro γ hγ γ' hγ' g h
    obtain ⟨w⟩ := (inferInstance : Nonempty (InfinitePlace F))
    have hX := rat_det_ne_zero_of_map X.J (B.emb w).1 (rat_det_ne_zero_of_hasSig _ (hP.herm.sig w))
    have hW := rat_det_ne_zero_of_map W.J (B.emb w).1 fun h0 =>
      rat_det_ne_zero_of_hasSig _ (hP.skew.sig w) (by rw [Matrix.det_smul, h0, mul_zero])
    have e : om (γ * g, γ' * h) Φ = om (γ, γ') (om (g, h) Φ) := by rw [← mul_apply_eq_comp, ← map_mul]; rfl
    show thetaSum F (om (γ * g, γ' * h) Φ) = thetaSum F (om (g, h) Φ); rw [e]
    exact darboux_coordinates_rational_exist F E σ hP.base.cm B.ψ hP.base.std n d X.J W.J hP.herm.herm hX
      hP.skew.skew hW M.co hP.good.rat χX χW hP.hX hP.hW om hP.weil γ hγ γ' hγ' _ (hS.pres _ _ hΦ)
  · obtain ⟨N₀, k₂, C₂, hL⟩ := _root_.PositivityTheory.ThKF0.LatSum.thetaSum_norm_le_pow F (Fin n × Fin d)
    obtain ⟨C₁, k₁, hA⟩ := PositivityTheory.ThKF0.Grow.schwartz_decay_uniform htBd finInv (sob_of derivOK) trBd
      F E σ B n d X W M χX χW om r s r' s' hP Φ hΦ N₀
    obtain ⟨C, -, hC⟩ := htBd F E σ n d X W M
    obtain ⟨m₀, hm₀, h₀⟩ := finInv F _ B.ψ hP.base.std Φ hΦ
    obtain ⟨D, hD, hDD⟩ := exists_dual_den F
    set C₃ : ℝ := D * m₀ * C
    refine ⟨|C₂| * |C₁| * |C₃| ^ k₂, k₁ + 1 * k₂, fun g h => ?_⟩
    obtain ⟨m, hm, hmC, hb⟩ := hC g h
    set H : ℝ := (ht g : ℝ) * ht h with hH
    have hH0 : 0 ≤ H := by rw [hH]; positivity
    have hm1 := Nat.mul_pos hD (Nat.mul_pos hm₀ hm)
    have hsupp : ∀ ξ : Fin n × Fin d → F, om (g, h) Φ (fun i => algebraMap F (AF F) (ξ i)) ≠ 0 →
        ∀ i, IsIntegral ℤ (((D * (m₀ * m) : ℕ) : F) * ξ i) := fun ξ hξ i => by
      rw [Nat.cast_mul D, mul_assoc]
      refine hDD _ fun y => trace_int hP.base.std _ ?_
      let u : AF F := (0, (algebraMap F (AF F) (y : F)).2)
      have hu : IntF u := ⟨rfl, fun v => HeightOneSpectrum.coe_mem_adicCompletionIntegers v y⟩
      have h0 : IntF (0 : AF F) := ⟨rfl, fun v => by rw [map_zero]; exact zero_mem _⟩
      have key := congrFun (h₀ _ _ _ _ (impl_sOf hP.weil g h) hb (0, Pi.single i u) ⟨fun _ => h0, fun j => by
        by_cases e : j = i
        · subst e; simpa using hu
        · simpa [e] using h0⟩) fun i => algebraMap F (AF F) (ξ i)
      simp only [schr, Prod.smul_mk, smul_zero, add_zero, Pi.zero_apply, zero_mul, mul_zero, dotProduct_smul,
        dotProduct_single] at key
      rw [← mul_right_cancel₀ hξ (key.trans (one_mul _).symm)]
      refine congrArg B.ψ (Prod.ext ?_ ?_)
      · change (0 : Ainf F) = ((m₀ * m : ℕ) : AF F).1 * ((algebraMap F (AF F) (ξ i)).1 * 0)
        simp
      · rw [map_mul, map_mul, map_natCast, mul_assoc]; rfl
    have hmC' : ((D * (m₀ * m) : ℕ) : ℝ) ≤ C₃ * H ^ 1 := by
      push_cast; rw [pow_one, mul_assoc, mul_assoc]; gcongr
    have hbL := hL (C₁ * H ^ k₁) (D * (m₀ * m)) (om (g, h) Φ) hm1 (fun ξ => hA g h _) hsupp
    have hA0 : 0 ≤ C₁ * H ^ k₁ :=
      le_trans (by positivity) (hA g h (fun i => algebraMap F (AF F) ((0 : Fin n × Fin d → F) i)))
    have hm0 : (0 : ℝ) ≤ ((D * (m₀ * m) : ℕ) : ℝ) ^ k₂ := by positivity
    have hmk : ((D * (m₀ * m) : ℕ) : ℝ) ^ k₂ ≤ (|C₃| * H ^ 1) ^ k₂ :=
      pow_le_pow_left₀ (Nat.cast_nonneg _)
        (hmC'.trans (mul_le_mul_of_nonneg_right (le_abs_self _) (pow_nonneg hH0 _))) _
    have hC1 : C₁ * H ^ k₁ ≤ |C₁| * H ^ k₁ := mul_le_mul_of_nonneg_right (le_abs_self _) (pow_nonneg hH0 _)
    calc ‖thetaSum F (om (g, h) Φ)‖ ≤ C₂ * (C₁ * H ^ k₁) * ((D * (m₀ * m) : ℕ) : ℝ) ^ k₂ := hbL
      _ ≤ |C₂| * (C₁ * H ^ k₁) * ((D * (m₀ * m) : ℕ) : ℝ) ^ k₂ :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self _) hA0) hm0
      _ ≤ |C₂| * (|C₁| * H ^ k₁) * (|C₃| * H ^ 1) ^ k₂ :=
            mul_le_mul (mul_le_mul_of_nonneg_left hC1 (abs_nonneg _)) hmk hm0
              (mul_nonneg (abs_nonneg _) (mul_nonneg (abs_nonneg _) (pow_nonneg hH0 _)))
      _ = |C₂| * |C₁| * |C₃| ^ k₂ * H ^ (k₁ + 1 * k₂) := by rw [pow_add, pow_mul]; ring
  · intro φ hφ g h
    obtain ⟨T, hT⟩ := hS.adm (g, h) l hl φ hφ
    refine T.continuous.congr fun f => ?_
    have hm : pureA F (f : (Fin n × Fin d → mixedEmbedding.mixedSpace F) → ℂ) φ ∈ schA F (Fin n × Fin d) :=
      Submodule.subset_span ⟨f, φ, hφ, rfl⟩
    rw [theta, ← hlt _ (hS.pres _ _ hm)]
    exact (hT f).symm
end

