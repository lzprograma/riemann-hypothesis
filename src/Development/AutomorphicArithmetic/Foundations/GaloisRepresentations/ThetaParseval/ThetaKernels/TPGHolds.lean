private def fixG_pk {F E : Type} [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E]
    {R : Type} [Ring R] (σ : E →ₐ[F] E) {n : ℕ} (X : Spc F E n) (f : AE F E →+* R) : Subgroup (UA σ X.J) where
  carrier := {g | (mat g).map f = 1}
  one_mem' := Matrix.map_one f (map_zero _) (map_one _)
  mul_mem' := fun {a b} ha hb => by
    show (mat (a * b)).map f = 1
    rw [Euler.mm, Matrix.map_mul]; exact (congrArg₂ (· * ·) ha hb).trans (mul_one _)
  inv_mem' := fun {a} ha => by
    have e : (mat a⁻¹).map f * (mat a).map f = 1 := by
      rw [← Matrix.map_mul, ← Euler.mm, inv_mul_cancel]; exact Matrix.map_one f (map_zero _) (map_one _)
    rwa [ha, mul_one] at e

private theorem nonVan_k :
    Tools_k → Rallis_k → Decomp_k → BumpAny_k → Datum_k → Tail_k → AbsNe → SchurStep_k → NonVan_k := by
  intro T hR hD hBu hDa hTl hAb hSc E _ _ _ B n d X W M χX χW om hP hn e e' he he' hd K a ε hK ha hε t₀ ht hlt U hU
    f₀ hf₀ hf0 φ hφ0 hS
  obtain ⟨a1, a2, a3⟩ := Euler.lcsc_UA (cj E) X.J
  have hC : Cpt (cj E) X.J := T.cpt _ E (cj E) B n X n 0 hP.base (Or.inl hP.herm) (by simp)
  have hA : IsAutFormU φ := by
    obtain ⟨V, _, _, _, ρ, i, jj, x₀, -, -, hjx, hjU, -, -⟩ := hS
    exact hU.aut φ (hjx ▸ hjU x₀)
  set φ' : UA (cj E) X.J → ℂ := φ ∘ e.symm with hφ'
  have hfn : IsFn φ' := ⟨hA.cont.comp e.symm.continuous, fun γ hγ g => by
    have h1 : e.symm γ ∈ GlobalTheory.UnitaryBC.ratU E n := (he.rat _).1 (by simpa using hγ)
    simpa [hφ'] using hA.left _ h1 (e.symm g)⟩
  have hφ'0 : φ' ≠ 0 := fun h => hφ0 (funext fun g => by simpa [hφ'] using congrFun h (e g))
  obtain ⟨r, r0, r1, r2⟩ := UpperTheory.matrix_coefficient_bounded_by_value_at_one (M := M) hC hP.good.haar hP.good.dom
    hfn hφ'0
  obtain ⟨O, oO, eO⟩ := isOpen_induced_iff.1 hA.level
  have one_O : (1 : GlobalTheory.UnitaryBC.UA E n) ∈ O :=
    show (1 : finU (E := E) (n := n)) ∈ Subtype.val ⁻¹' O by rw [eO]; show RU E n 1 φ = φ; rw [map_one]; rfl
  set N : Set (UA (cj E) X.J) := e.symm ⁻¹' O with hN
  have oN : IsOpen N := oO.preimage e.symm.continuous
  have one_N : (1 : UA (cj E) X.J) ∈ N := by simpa [hN] using one_O
  have hfix : ∀ g ∈ gOff (cj E) X ∅, g ∈ N → ∀ y, φ' (y * g) = φ' y := fun g hg hgN y => by
    have k1 : e.symm g ∈ finU (E := E) (n := n) := (he.fin _).1 (by simpa using hg)
    have k2 : (⟨e.symm g, k1⟩ : finU (E := E) (n := n)) ∈ {k : finU (E := E) (n := n) | RU E n k φ = φ} := by
      rw [← eO]; exact hgN
    simpa [hφ'] using congrFun k2 (e.symm y)
  obtain ⟨⟨j0, hj0⟩, -, -, -, cK0, -, -, -, -⟩ := hD _ E (cj E) B n X hP.base hP.herm ∅
  have clOff : ∀ S, IsClosed (gOff (cj E) X S : Set (UA (cj E) X.J)) := fun S =>
    (hD _ E (cj E) B n X hP.base hP.herm S).2.2.2.1
  obtain ⟨S₀, hS₀⟩ : ∃ S₀ : Finset (Pl (maximalRealSubfield E)), ∀ c ∈ gOff (cj E) X S₀, IntAll c → c ∈ N := by
    have hs : IsCompact ({g : UA (cj E) X.J | IntAll g} ∩ (interior N)ᶜ) :=
      cK0.inter_right isOpen_interior.isClosed_compl
    have anti : ∀ {S T : Finset (Pl (maximalRealSubfield E))}, S ⊆ T →
        (gOff (cj E) X T : Set (UA (cj E) X.J)) ⊆ gOff (cj E) X S := fun h =>
      Subgroup.closure_mono fun g hg => ⟨hg.1, fun v hv => hg.2 v (h hv)⟩
    have hi : ({g : UA (cj E) X.J | IntAll g} ∩ (interior N)ᶜ) ∩
        ⋂ S : Finset (Pl (maximalRealSubfield E)), (gOff (cj E) X S : Set (UA (cj E) X.J)) = ∅ := by
      refine Set.eq_empty_of_forall_notMem fun c hc => ?_
      have h := Set.mem_iInter.1 hc.2
      have h1 : ∀ w, (mat c).map (compInf (maximalRealSubfield E) E w) = 1 := fun w =>
        (show gOff (cj E) X ∅ ≤ fixG_pk (cj E) X (compInf _ E w : AE _ E →+* _) from
          (Subgroup.closure_le _).2 fun _ hg => hg.1 w) (h ∅)
      have h2 : ∀ v, OffAt v c := fun v =>
        (show gOff (cj E) X {v} ≤ fixG_pk (cj E) X (compFin _ E v : AE _ E →+* _) from
          (Subgroup.closure_le _).2 fun _ hg => hg.2 v (Finset.mem_singleton_self v)) (h {v})
      have e1 : c = 1 := Subtype.ext (Units.ext (Matrix.ext fun i j => sub_eq_zero.1
        (GlobalTheory.SWOpFin.tens_eq_zero_of_comp
          (fun v => by
            have ev := (h2 v).trans (Matrix.map_one (compFin _ E v) (map_zero _) (map_one _)).symm
            rw [map_sub]; exact sub_eq_zero.2 (congrFun (congrFun ev i) j))
          (fun w => by
            have ew := (h1 w).trans (Matrix.map_one (compInf _ E w) (map_zero _) (map_one _)).symm
            rw [map_sub]; exact sub_eq_zero.2 (congrFun (congrFun ew i) j)))))
      exact hc.1.2 (e1 ▸ mem_interior_iff_mem_nhds.2 (oN.mem_nhds one_N))
    obtain ⟨S, hS'⟩ := hs.elim_directed_family_closed _ clOff (Set.disjoint_iff_inter_eq_empty.mpr hi)
      fun S T => ⟨S ∪ T, anti Finset.subset_union_left, anti Finset.subset_union_right⟩
    exact ⟨S, fun c hc hI => by_contra fun hn => Set.disjoint_left.mp hS' ⟨hI, fun h => hn (interior_subset h)⟩ hc⟩
  have hfinR : {w : HeightOneSpectrum (𝓞 E) | ¬ UnrAt χW w}.Finite :=
    Filter.eventually_cofinite.1 (GlobalTheory.PairVac.eventually_unrAt_of_isHecke (cj E) hP.base.cm χW hP.hW)
  let R : Finset (Pl (maximalRealSubfield E)) := (hfinR.image fun w => w.under (𝓞 (maximalRealSubfield E))).toFinset
  have hRam : UnrOff χW (R : Set (Pl (maximalRealSubfield E))) := fun w hw => by_contra fun hu =>
    hw (by
      show w.under (𝓞 (maximalRealSubfield E)) ∈ (R : Set (Pl (maximalRealSubfield E)))
      simp only [R, Finset.mem_coe, Set.Finite.mem_toFinset]; exact ⟨w, hu, rfl⟩)
  obtain ⟨S, hSS, hTail⟩ := hTl _ E (cj E) B n X hP.base hP.herm K a ε hK ha hε M.μ ((d : ℝ) / 2) hP.good.haar
    (ht _ hlt.le) (S₀ ∪ R)
  have hOffS : gOff (cj E) X S ≤ gOff (cj E) X S₀ := Subgroup.closure_mono fun g hg =>
    ⟨hg.1, fun v hv => hg.2 v (hSS (Finset.mem_union_left _ hv))⟩
  have hOff0 : gOff (cj E) X S ≤ gOff (cj E) X ∅ := Subgroup.closure_mono fun g hg =>
    ⟨hg.1, fun _ hv => absurd hv (by simp)⟩
  have hunr : UnrOff χW (S : Set (Pl (maximalRealSubfield E))) := fun w hw => hRam w fun h => hw (by
    simp only [above, Set.mem_ofPred_eq] at h ⊢; exact hSS (Finset.mem_union_right _ h))
  choose H b hb hHN using fun v => hBu _ E (cj E) B n d X W M χX χW om hP hn hd v N (oN.mem_nhds one_N)
  set φf : ∀ v : Pl (maximalRealSubfield E), (Fin n × Fin d → Fv (maximalRealSubfield E) v) → ℂ :=
    fun v => if v ∈ S then b v else M.vac v with hφf
  have hfin : IsFin M φf := ⟨fun v => by by_cases hv : v ∈ S <;> [simpa [hφf, hv] using (hb v).1;
      simpa [hφf, hv] using (hP.good.vac v).1],
    by filter_upwards [S.finite_toSet.compl_mem_cofinite] with v hv
       simp only [Set.mem_compl_iff, Finset.mem_coe] at hv; simp [hφf, hv]⟩
  let : MeasurableSpace (Fin n × Fin d → AF (maximalRealSubfield E)) := borel _
  have : BorelSpace (Fin n × Fin d → AF (maximalRealSubfield E)) := ⟨rfl⟩
  let ν : Measure (Fin n × Fin d → AF (maximalRealSubfield E)) := Measure.addHaar
  have hν : ν.IsAddHaarMeasure := inferInstance
  obtain ⟨hc1, hco⟩ := hDa _ E (cj E) B n d X W M χX χW om hP hn K a ε hK ha hε ν hν S hunr H φf hfin
    (fun v hv => by simpa [hφf, hv] using hb v) (fun v hv => by simp [hφf, hv]) f₀ hf₀ hf0
  obtain ⟨⟨j, hj⟩, cInf, clAt, clOff', cK, oK, -, hcomp, -⟩ := hD _ E (cj E) B n X hP.base hP.herm S
  let Tst : Subgroup (UA (cj E) X.J) :=
    { carrier := {g | ∀ y, φ' (y * g) = φ' y}
      one_mem' := fun y => by rw [mul_one]
      mul_mem' := fun {g h} hg hh y => by rw [← mul_assoc, hh, hg]
      inv_mem' := fun {g} hg y => by rw [← hg (y * g⁻¹), inv_mul_cancel_right] }
  have hHfix : (⨆ v ∈ S, H v) ≤ Tst := iSup₂_le fun v _ g hg =>
    hfix g (UpperTheory.unitaryLocalGroup_le_offPlaces_empty v ((hb v).2.2.1 hg)) (hHN v hg)
  have hcomm : ∀ (b : gAt (cj E) X S) (c : gOff (cj E) X S), b.1 * c.1 = c.1 * b.1 := fun b c => by
    have h1 : j ((1, (b, 1)) * (1, (1, c))) = j ((1, (1, c)) * (1, (b, 1))) := by congr 1; simp
    rw [map_mul, map_mul, hj, hj] at h1; simpa using h1
  have hmc : ∀ (x : UA (cj E) X.J) (b : gAt (cj E) X S) (c : gOff (cj E) X S), b.1 ∈ (⨆ v ∈ S, H v) →
      mc M φ' (x * b.1 * c.1) = mc M φ' (x * c.1) := fun x b c hbH => by
    have : (fun y => φ' (y * (x * b.1 * c.1))) = fun y => φ' (y * (x * c.1)) := funext fun y => by
      rw [mul_assoc x, hcomm, ← mul_assoc x, ← mul_assoc y]; exact hHfix hbH _
    simp only [mc, this]
  have : LocallyCompactSpace (gInf (cj E) X) := cInf.isClosed.isClosedEmbedding_subtypeVal.locallyCompactSpace
  have : LocallyCompactSpace (gAt (cj E) X S) := clAt.isClosedEmbedding_subtypeVal.locallyCompactSpace
  have : LocallyCompactSpace (gOff (cj E) X S) := clOff'.isClosedEmbedding_subtypeVal.locallyCompactSpace
  let μA : Measure (gInf (cj E) X) := Measure.haar
  let μB : Measure (gAt (cj E) X S) := Measure.haar
  let μC : Measure (gOff (cj E) X S) := Measure.haar
  have : SFinite μA := nv_sf_pk μA; have : SFinite μB := nv_sf_pk μB; have : SFinite μC := nv_sf_pk μC
  obtain ⟨κ, hκ, hκe⟩ := hSc E B n d X W M χX χW om hP hn e e' he he' U hU f₀ hf0 φ hφ0 hS ν hν φf hfin μA inferInstance
  have hPol : pure f₀ φf ∈ PolData B M := Submodule.subset_span ⟨f₀, hf₀, φf, hfin.1, hfin.2, rfl⟩
  obtain ⟨hI, hZ⟩ := hR _ E (cj E) B n d X W M χX χW om hP hn (by omega) K a ε hK ha hε t₀ ht hlt ν hν _ hPol φ' hfn
  refine ⟨φf, hfin, fun h0 => ?_⟩
  obtain ⟨hIP, c, hc⟩ := UpperTheory.haarMeasure_triple_product_decomposition _ _ _ cInf.isClosed clAt clOff' j M.μ
    hP.good.haar μA μB μC inferInstance inferInstance inferInstance _ hI
  rw [hZ h0, mul_zero] at hc
  choose s s1 s2 s3 using fun c : gOff (cj E) X S => (hco 1 (one_mem _) 1 (one_mem _) c.1 c.2).2
  have oH := UpperTheory.unitaryAdelic_mem_of_localGroups_near_one S H (fun v _ => (hb v).2.2.2.2.1) hcomp
  have hIG : ∀ g ∈ (⨆ v ∈ S, H v), IntAll g := fun g hg =>
    Subgroup.mem_iInf.1 ((iSup₂_le fun v _ g hg => Subgroup.mem_iInf.2 fun w =>
      Bad.int_all ((hb v).2.2.1 hg) ((hb v).2.2.2.1 g hg) w : (⨆ v ∈ S, H v) ≤ ⨅ w, Euler.intGrp (cj E) X w) hg)
  have cB : IsCompact {b : gAt (cj E) X S | IntAll b.1} := clAt.isClosedEmbedding_subtypeVal.isCompact_preimage cK
  have cC : IsCompact {c : gOff (cj E) X S | IntAll c.1} := clOff'.isClosedEmbedding_subtypeVal.isCompact_preimage cK
  refine hAb _ _ _ μA μB μC {b | b.1 ∈ ⨆ v ∈ S, H v} {c | IntAll c.1} oH.measurableSet
    (oK.preimage continuous_subtypeVal).measurableSet (oH.measure_ne_zero μB ⟨1, one_mem (⨆ v ∈ S, H v)⟩)
    (ne_top_of_le_ne_top cB.measure_lt_top.ne (measure_mono fun b hb' => hIG _ hb')) cC.measure_lt_top.ne
    _ (fun x c => coef om ν (pure f₀ φf) x.1 * star (mc M φ' (x.1 * c.1))) s (fun c => star (mc M φ' c.1))
    (κ * coef om ν (pure f₀ φf) 1) r (fun c => ENNReal.ofReal (a (ε (c.1, 1)) ^ ((d : ℝ) / 2)))
    (mul_ne_zero hκ hc1) r0 hIP
    (fun x b c hb' => by rw [hj, (hco x.1 x.2 b.1 b.2 c.1 c.2).1 hb', zero_mul])
    (fun x c b hb' => by rw [hj]; simp only; rw [s3 c x.1 x.2 b.1 hb', hmc _ _ _ hb', mul_assoc])
    (fun c => hκe c.1 (hOff0 c.2))
    (fun c hc' => ⟨s2 c hc', by
      have : (fun y => φ' (y * c.1)) = fun y => φ' (y * 1) := funext fun y => by
        rw [mul_one]; exact hfix _ (hOff0 c.2) (hS₀ _ (hOffS c.2) hc') y
      have e1 : mc M φ' c.1 = r := by rw [← r1]; simp only [mc, this]
      simp [e1]⟩)
    (fun c => ⟨by simpa using r2 c.1, by rw [← s1 c, ofReal_norm]⟩)
    (hTail μC inferInstance) hc

private theorem realPair_k : Tools_k → RealPair_k := by
  intro T E _ _ _ B n d X W M χX χW om hP hn e e' he he' hnd δ mX mW hXJ hWJ eX eW U lam hU hwt hdom
  obtain ⟨Φ, a, b, hinj, hran, ha, hb, h1, h2⟩ :=
    RP.fockOf_k T E B n d X W M χX χW om hP hn hnd e e' he he' δ mX mW hXJ hWJ eX eW
  have hμ : ∀ w, ∃ μ : Fin n → ℕ, ∀ k, (μ k : ℤ) + a w = (lam w).w k := fun w =>
    ⟨fun k => ((lam w).w k - a w).toNat, fun k => by
