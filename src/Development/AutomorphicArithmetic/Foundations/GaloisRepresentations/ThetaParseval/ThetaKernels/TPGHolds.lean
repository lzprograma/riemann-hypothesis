      rw [he, diagCols, Matrix.fromRows_mul, Matrix.fromBlocks_mul_fromRows]; simp
    have e1 : e (g, 1) = e (g, g) * e (1, g⁻¹) := by rw [← map_mul, Prod.mk_mul_mk, mul_one, mul_inv_cancel]
    rw [e1, ha.mul hp, GlobalTheory.WeilEx.Jac.absE_det_unitary hJ g]; simp
  obtain ⟨c, -, hc⟩ := inv_scale μ
