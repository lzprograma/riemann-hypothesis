section SplitFree
open GlobalTheory.KSplit GlobalTheory.SplitFlip GlobalTheory.OppLagr

private abbrev mulH_pk {K : Type} [Field K] [TopologicalSpace K] [IsTopologicalRing K] {n d : ℕ}
    (a : GL (Fin n) K) (c : GL (Fin d) K) :=
  UpperTheory.Reformulated.B.MatrixHomeomorphOfGeneralLinearPair.mulH_pk a c

private theorem splitFree_pk : GlobalTheory.ThK.Dbl.SplitModel_k := by
  intro F E _ _ _ _ _ σ B n d X W M χX χW om r s r' s' hp v t
  have hcm := hp.base.cm
  have hJX : (X.J.map (t.comp σ)).det ≠ 0 := det_map_ne_zero (det_ne_zero_herm hp.herm) _
  have hJW : (W.J.map (t.comp σ)).det ≠ 0 := det_map_ne_zero (det_ne_zero_skew hp.skew) _
  let P : GL (Fin n) (Fv F v) := Matrix.nonsingInvUnit (-(X.J.map (t.comp σ))) (isUnit_iff_ne_zero.mpr (by
    rw [Matrix.det_neg]; exact mul_ne_zero (pow_ne_zero _ (by norm_num)) hJX))
  let Q : GL (Fin d) (Fv F v) := Matrix.nonsingInvUnit (W.J.map (t.comp σ))ᵀ (isUnit_iff_ne_zero.mpr (by
    rw [Matrix.det_transpose]; exact hJW))
  obtain ⟨⟨ι₀, hι₀⟩, -, -, kdict⟩ := PositivityTheory.KCo.dictX_proof_k F E σ n d B X W M om χX χW hp.base
    ⟨_, _, hp.herm⟩ ⟨_, _, hp.skew⟩ hp.weil v (t.comp σ)
  have hPv : P.1 = -(X.J.map (t.comp σ)) := rfl
  have hQv : Q.1 = (W.J.map (t.comp σ))ᵀ := rfl
  have cw : ∀ u : Matrix (Fin n) (Fin d) (Fv F v),
      ((1 : GL (Fin n) (Fv F v))⁻¹).1 * u * ((1 : GL (Fin d) (Fv F v))⁻¹).1ᵀ = u := fun u => by simp
  refine ⟨⟨funLeft ℂ ℂ (mulH_pk P Q) ∘ₗ ι₀, ?_⟩,
    fun ι hι g hg h hh g₀ h₀ eg eh φ hφ φ₁ hφ₁ hA => ?_⟩
  · unfold Model.IsLinBar at hι₀; unfold Model.IsLinW; rw [comp_comp hcm] at hι₀
    have co : ∀ u : Matrix (Fin n) (Fin d) (Fv F v),
        -((1 : GL (Fin n) (Fv F v)).1ᵀ * X.J.map (t.comp σ) * u * (W.J.map (t.comp σ))ᵀ * (1 : GL (Fin d) (Fv F v)).1)
          = P.1 * u * Q.1 := fun u => by
      rw [hPv, hQv]; simp only [Units.val_one, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one, Matrix.neg_mul]
    refine ⟨PositivityTheory.KCo.bij_comp hι₀.bij (mulH_pk P Q), fun u hu h0 φ hφ φ₁ hφ₁ hA Y => ?_,
      fun u hu h0 φ hφ φ₁ hφ₁ hA x hx hx0 => ?_⟩
    · have e := hι₀.trans u hu h0 φ hφ φ₁ hφ₁ hA (P.1 * Y * Q.1)
      simp only [co] at e; simp only [LinearMap.comp_apply, funLeft_apply, cw]
      change ι₀ φ₁ (P.1 * Y * Q.1) = ι₀ φ (P.1 * (Y + u.map (piW t)) * Q.1)
      rw [Matrix.mul_add, Matrix.add_mul]; exact e
    · have e := hι₀.mult u hu h0 φ hφ φ₁ hφ₁ hA x hx hx0
      simp only [co] at e; simp only [LinearMap.comp_apply, funLeft_apply, cw]
      change ι₀ φ₁ (P.1 * x.map (piW t) * Q.1) = _; exact e
  · have ha : (P⁻¹).1 * X.J.map (t.comp σ) = -1 := by
      have := Units.inv_mul P; rw [hPv, Matrix.mul_neg] at this; exact neg_eq_iff_eq_neg.mp this
    have hc : (W.J.map (t.comp σ))ᵀ * (Q⁻¹).1 = 1 := by rw [← hQv]; exact Units.mul_inv Q
    have hι' : M.IsLinBar B.ψ (t.comp σ) 1 1 (funLeft ℂ ℂ (mulH_pk P⁻¹ Q⁻¹) ∘ₗ ι) := by
      unfold Model.IsLinBar; unfold Model.IsLinW at hι; rw [comp_comp hcm]
      have co : ∀ u : Matrix (Fin n) (Fin d) (Fv F v),
          (P⁻¹).1 * (-((1 : GL (Fin n) (Fv F v)).1ᵀ * X.J.map (t.comp σ) * u * (W.J.map (t.comp σ))ᵀ *
            (1 : GL (Fin d) (Fv F v)).1)) * (Q⁻¹).1 = u := fun u => by
        simp only [Units.val_one, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one, Matrix.mul_neg, Matrix.neg_mul]
        rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, ha, Matrix.mul_assoc, Matrix.mul_assoc, hc]; simp
      refine ⟨PositivityTheory.KCo.bij_comp hι.bij (mulH_pk P⁻¹ Q⁻¹), fun u hu h0 φ hφ φ₁ hφ₁ hA Y => ?_,
        fun u hu h0 φ hφ φ₁ hφ₁ hA x hx hx0 => ?_⟩
      · have e := hι.trans u hu h0 φ hφ φ₁ hφ₁ hA ((P⁻¹).1 * Y * (Q⁻¹).1)
        simp only [cw] at e; simp only [LinearMap.comp_apply, funLeft_apply]
        change ι φ₁ ((P⁻¹).1 * Y * (Q⁻¹).1) = ι φ ((P⁻¹).1 * (Y + _) * (Q⁻¹).1)
        rw [Matrix.mul_add, Matrix.add_mul, co]; exact e
      · have e := hι.mult u hu h0 φ hφ φ₁ hφ₁ hA x hx hx0
        simp only [cw] at e; simp only [LinearMap.comp_apply, funLeft_apply]
        change ι φ₁ ((P⁻¹).1 * (_ : Matrix (Fin n) (Fin d) (Fv F v)) * (Q⁻¹).1) =
          B.ψ _ * ι φ ((P⁻¹).1 * (_ : Matrix (Fin n) (Fin d) (Fv F v)) * (Q⁻¹).1)
        rw [co]; exact e
    obtain ⟨kg, kh⟩ := kdict _ hι'
    let g₁ := Matrix.GeneralLinearGroup.map (piW (t.comp σ)) g.1
    let h₁ := Matrix.GeneralLinearGroup.map (piW (t.comp σ)) h.1
    obtain ⟨φ', hφ', hA', e'⟩ := kh h hh h₁ rfl φ hφ
    obtain ⟨φ'', hφ'', hA'', e''⟩ := kg g hg g₁ rfl φ' hφ'
    have hcomp : Acts (evFin F v) (om (g, h)) φ φ'' := fun R hR => by
      have e : om (g, h) = om (g, 1) * om (1, h) := by rw [← map_mul]; simp
      rw [e, mul_apply_eq_comp, hA' R hR, hA'' R ⟨hR.1, by
        rw [← hA' R hR]; exact hp.weil.isUSplitting.pres (1, h) _ hR.2⟩]
    obtain ⟨hex, -, -⟩ := PositivityTheory.ThKF0.actsEx_k F E σ B n d X W M χX χW om r s r' s' hp v
    have e1 := (hex g hg h hh φ hφ).unique ⟨hφ₁, hA⟩ ⟨hφ'', hcomp⟩
    have key : (funLeft ℂ ℂ (mulH_pk P⁻¹ Q⁻¹) ∘ₗ ι) φ'' =
        omB (chrW χW (t.comp σ)) (chrW χX (t.comp σ)) g₁ h₁ ((funLeft ℂ ℂ (mulH_pk P⁻¹ Q⁻¹) ∘ₗ ι) φ) := by
      rw [e'', e', ← omB_mul, mul_one, one_mul]
    have ug := GlobalTheory.Div.CoordOpp.unit_map σ g (t.comp σ)
    have uh := GlobalTheory.Div.CoordOpp.unit_map σ h (t.comp σ)
    rw [comp_comp hcm, ← eg] at ug; rw [comp_comp hcm, ← eh] at uh
    have ug' : g₁.1ᵀ * X.J.map (t.comp σ) * g₀.1 = X.J.map (t.comp σ) := ug
    have uh' : h₁.1ᵀ * W.J.map (t.comp σ) * h₀.1 = W.J.map (t.comp σ) := uh
    have cg : g₀⁻¹ = P⁻¹ * (invT g₁)⁻¹ * P := by
      symm; rw [eq_inv_iff_mul_eq_one]; apply Units.ext
      simp only [Units.val_mul, Units.val_one, invT_inv_val]
      have e0 : g₁.1ᵀ * P.1 * g₀.1 = P.1 := by rw [hPv, Matrix.mul_neg, Matrix.neg_mul, ug']
      rw [show (P⁻¹).1 * g₁.1ᵀ * P.1 * g₀.1 = (P⁻¹).1 * (g₁.1ᵀ * P.1 * g₀.1) by simp only [Matrix.mul_assoc], e0]
      exact Units.inv_mul P
    have ch : invT h₀ = Q * h₁ * Q⁻¹ := by
      rw [← inv_mul_eq_one]; apply Units.ext
      simp only [Units.val_mul, Units.val_one, invT_inv_val]
      have e0 : h₀.1ᵀ * Q.1 * h₁.1 = Q.1 := by
        simpa [hQv, Matrix.transpose_mul, Matrix.mul_assoc] using congrArg Matrix.transpose uh'
      rw [show h₀.1ᵀ * (Q.1 * h₁.1 * (Q⁻¹).1) = h₀.1ᵀ * Q.1 * h₁.1 * (Q⁻¹).1 by simp only [Matrix.mul_assoc], e0]
      exact Units.mul_inv Q
    have gi : ∀ {m : ℕ} (x : GL (Fin m) (Fv F v)), gdet x⁻¹ = (gdet x)⁻¹ :=
      fun x => map_inv Matrix.GeneralLinearGroup.det x
    have dg : gdet g₁ = (gdet g₀)⁻¹ := by
      have e0 := congrArg gdet cg; rw [gi, gdet_mul, gdet_mul, gi, gi, gdet_invT] at e0
      rw [e0, inv_inv, mul_comm, ← mul_assoc, mul_inv_cancel, one_mul]
    have dh : gdet h₁ = (gdet h₀)⁻¹ := by
      have e0 := congrArg gdet ch; rw [gdet_invT, gdet_mul, gdet_mul, gi] at e0
      rw [e0, mul_comm (gdet Q), mul_assoc, mul_inv_cancel, mul_one]
    rw [e1]; funext Y
    have hm : ∀ (ψ' : (Fin n × Fin d → Fv F v) → ℂ) y, (funLeft ℂ ℂ (mulH_pk P⁻¹ Q⁻¹) ∘ₗ ι) ψ' y =
        ι ψ' ((P⁻¹).1 * y * (Q⁻¹).1) := fun _ _ => rfl
    have hy : ι φ'' Y = (funLeft ℂ ℂ (mulH_pk P⁻¹ Q⁻¹) ∘ₗ ι) φ'' (P.1 * Y * Q.1) := by
      rw [hm]; simp only [Matrix.mul_assoc, Units.mul_inv, Matrix.mul_one]
      rw [← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul]
    have c1 : (g₀⁻¹).1 = (P⁻¹).1 * g₁.1ᵀ * P.1 := by rw [cg]; rfl
    have c2 : (invT h₀).1 = Q.1 * h₁.1 * (Q⁻¹).1 := by rw [ch]; rfl
    rw [hy, key, chrW_comp hcm χW hp.resW, chrW_comp hcm χX hp.resX]
    simp only [omA, omB]
    rw [hm, show (P⁻¹).1 * (g₁.1ᵀ * (P.1 * Y * Q.1) * h₁.1) * (Q⁻¹).1 =
        (P⁻¹).1 * g₁.1ᵀ * P.1 * Y * (Q.1 * h₁.1 * (Q⁻¹).1) by simp only [Matrix.mul_assoc], c1, c2, dg, dh]
    simp only [map_inv, MonoidHom.inv_apply, inv_inv, apow_inv, neg_div]
end SplitFree
