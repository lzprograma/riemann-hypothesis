  refine ⟨t₀, fun μ hμ t ht => ?_⟩
  have := hμ₀; have := cX.right μ hμ
  have hJ := Hgt.det_ne (.inl hX)
  have h1 : Integrable (fun g => a (e (1, g)) ^ t) μ := by
    rw [Measure.isMulLeftInvariant_eq_smul μ μ₀]; exact (ht₀ t ht).smul_measure ENNReal.coe_ne_top
  have hsw : ∀ g : UA σ X.J, a (e (g, 1)) = a (e (1, g⁻¹)) := fun g => by
