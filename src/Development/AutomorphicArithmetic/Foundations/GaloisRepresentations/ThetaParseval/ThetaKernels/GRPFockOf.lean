private theorem omAct_one_pk {n d : ℕ} (M : Matrix (Ln n 0 d 0) (Ln n 0 d 0) ℂ) :
    omAct n 0 d 0 M (1 : Formalism.BasicNotions.TH.Pol n 0 d 0) = ((1 / 2 : ℂ) * M.trace) • (1 :
      Formalism.BasicNotions.TH.Pol n 0 d 0) := by
  have hE : ∀ l l' : Ln n 0 d 0, omE l l' (1 : Formalism.BasicNotions.TH.Pol n 0 d 0) =
      if l = l' then (1 / 2 : ℂ) • (1 : Formalism.BasicNotions.TH.Pol n 0 d 0) else 0 := by
    rintro l ⟨(i | i), (j | j)⟩
    · have h0 : lowB ((Sum.inl i, Sum.inl j) : Ln n 0 d 0) (1 : Formalism.BasicNotions.TH.Pol n 0 d 0) = 0 := by
        simp [lowB, linePos]
      simp only [omE, LinearMap.add_apply, mul_apply_eq_comp, h0, map_zero, zero_add]
      split_ifs <;> simp
    · exact j.elim0
    · exact i.elim0
    · exact i.elim0
  simp only [omAct, LinearMap.sum_apply, LinearMap.smulRight_apply, Matrix.entryLinearMap_apply, LinearMap.smul_apply,
    hE]
  simp only [smul_ite, smul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true, Matrix.trace, Matrix.diag_apply]
  rw [← Finset.sum_smul, smul_smul, mul_comm]
private theorem fock_first_action_one_polynomial {n d : ℕ} (Y : Mat n 0) :
    fockAct1 n 0 d 0 Y (1 : Formalism.BasicNotions.TH.Pol n 0 d 0) = (((d : ℂ) / 2) * Y.trace) • (1 :
      Formalism.BasicNotions.TH.Pol n 0 d 0) := by
  have : (Matrix.kroneckerMapBilinear (LinearMap.mul ℂ ℂ)).flip (1 : Mat d 0) Y = Matrix.kroneckerMap (· * ·) Y (1 : Mat
    d 0) := rfl
  rw [fockAct1, LinearMap.comp_apply, this, omAct_one_pk]
  congr 1
  rw [Matrix.trace_kronecker Y (1 : Mat d 0), Matrix.trace_one]
  simp only [Fintype.card_sum, Fintype.card_fin, add_zero]
  ring
private theorem fock_second_action_one_polynomial {n d : ℕ} (Y : Mat d 0) :
    fockAct2 n 0 d 0 Y (1 : Formalism.BasicNotions.TH.Pol n 0 d 0) = (((n : ℂ) / 2) * Y.trace) • (1 :
      Formalism.BasicNotions.TH.Pol n 0 d 0) := by
  have : (Matrix.kroneckerMapBilinear (LinearMap.mul ℂ ℂ)) (1 : Mat n 0) Y = Matrix.kroneckerMap (· * ·) (1 : Mat n 0) Y
    := rfl
  rw [fockAct2, LinearMap.comp_apply, this, omAct_one_pk]
  congr 1
  rw [Matrix.trace_kronecker (1 : Mat n 0) Y, Matrix.trace_one]
  simp only [Fintype.card_sum, Fintype.card_fin, add_zero]
  ring
private theorem jm_zero_pk (N : ℕ) : Jm N 0 = 1 := by
  ext a b
  rcases a with a | a
  · rcases b with b | b
    · simp [Jm, Formalism.UG.Jpq, Matrix.one_apply]
    · exact b.elim0
  · exact a.elim0
private theorem isKC_all_pk {N : ℕ} (Y : Mat N 0) : IsKC Y := by
  rintro (a | a) (b | b) h
  · exact absurd trivial h
  · exact b.elim0
  · exact a.elim0
  · exact a.elim0
private theorem isExp_unique_pk {V : Type} [AddCommGroup V] [Module ℂ V] {L U U' : Module.End ℂ V} (h : IsExp L U) (h' :
  IsExp L U') :
    U = U' :=
  LinearMap.ext fun v => sub_eq_zero.1 ((Module.forall_dual_apply_eq_zero_iff ℂ _).1 fun l => by
    rw [map_sub, (h v l).unique (h' v l), sub_self])
private theorem sumPl_tprod_pk {ι : Type} [Fintype ι] [DecidableEq ι] {V : ι →
  Type} [∀ i, AddCommGroup (V i)] [∀ i, Module ℂ (V i)]
    (L : ∀ i, Module.End ℂ (V i)) (f : ∀ i, V i) (c : ι → ℂ) (h : ∀ i, L i (f i) = c i • f i) :
    sumPl L (PiTensorProduct.tprod ℂ f) = (∑ i, c i) • PiTensorProduct.tprod ℂ f := by
  rw [sumPl, LinearMap.sum_apply, Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [atPl, PiTensorProduct.map_tprod]
  have e : (fun j => Function.update (fun j => (LinearMap.id : V j →ₗ[ℂ] V j)) i (L i) j (f j)) = Function.update f i (c
    i • f i) := by
    funext j
    by_cases hj : j = i
    · subst hj; simp [h]
    · simp [Function.update_of_ne hj]
  rw [e, MultilinearMap.map_update_smul, Function.update_eq_self]
  rfl
