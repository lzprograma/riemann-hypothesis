  have hform := hU.aut φ (hj ▸ hjU x₀)
  obtain ⟨Ω, hΩ, hcov⟩ := C.cov
  refine ⟨((μA.real Set.univ / (Module.finrank ℂ V : ℝ) : ℝ) : ℂ),
    Complex.ofReal_ne_zero.2 (div_pos (ENNReal.toReal_pos (IsOpen.measure_pos μA isOpen_univ Set.univ_nonempty).ne'
      (measure_ne_top _ _)) (by exact_mod_cast Module.finrank_pos (R := ℂ) (M := V))).ne', fun cc _ => ?_⟩
  have hmain := assemble_pk M.μ (ratU (cj E) X.J) M.dom P.good.dom (C.fin _ _ hHaar P.good.dom) Ω hΩ hcov μA π hI
    (gInf (cj E) X).subtype measurable_subtypeVal f hf0 (fun a => (hU.aut _ (hjU a)).cont.comp e.symm.continuous)
    (fun a γ hγ _ => by
      show j a (e.symm (γ * _)) = j a (e.symm _); rw [map_mul]
      exact (hU.aut _ (hjU a)).left _ ((he.rat _).1 (by simpa using hγ)) _)
    (fun x a y => by show j (ρ (p x) a) (e.symm y) = j a (e.symm (y * x.1)); rw [hR, map_mul]; rfl)
    B₁ hB₁ x₀ (fun y => φ (e.symm (y * cc))) (hform.cont.comp (e.symm.continuous.comp (continuous_mul_const cc)))
    (fun γ hγ _ => by
      show φ (e.symm (γ * _ * cc)) = φ (e.symm (_ * cc)); rw [mul_assoc, map_mul]
      exact hform.left _ ((he.rat _).1 (by simpa using hγ)) _)
  rw [show f x₀ = φ ∘ e.symm from funext fun _ => by show j x₀ _ = _; rw [hj]; rfl] at hmain
  have e1 : ∀ x : gInf (cj E) X, coef om ν (pWT f₀ φf) x.1 * star (mc M (φ ∘ e.symm) (x.1 * cc)) =
      (c : ℂ)⁻¹ * (B₁ (π x x₀) x₀ * star (pet M.μ M.dom (fun y => φ (e.symm (y * (gInf (cj E) X).subtype x * cc)))
        (φ ∘ e.symm))) := fun x => by
    rw [hco, mul_assoc]; simp only [mc, Function.comp_apply, mul_assoc, Subgroup.subtype_apply]
  simp_rw [e1]; rw [integral_const_mul, hmain, hco1]
  change _ = _ * _ * star (pet M.μ M.dom (fun y => φ (e.symm (y * cc))) _); ring

private theorem abs_tail_pk {G D C : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [MeasurableSpace G]
    [BorelSpace G] [LocallyCompactSpace G] [SecondCountableTopology G] [Group D] [TopologicalSpace D]
    [IsTopologicalGroup D] [MeasurableSpace D] [BorelSpace D] [LocallyCompactSpace D] [SecondCountableTopology D]
    [Group C] [TopologicalSpace C] [IsTopologicalGroup C] [MeasurableSpace C] [BorelSpace C] [LocallyCompactSpace C]
    [SecondCountableTopology C] (j : D × C ≃ₜ* G) (μ : Measure G) [μ.IsHaarMeasure] (μC : Measure C) [μC.IsHaarMeasure]
    {U W : Set G} {K : Set C} (hU : IsOpen U) (hUc : IsCompact U) (h1 : (1 : G) ∈ U) (hK : MeasurableSet K)
    (f : G → ENNReal) (F : C → ENNReal) (hF : Measurable F) (hc : ∀ d c, j (d, c) ∈ U → j (d, 1) ∈ U ∧ c ∈ K)
    (hm : ∀ d c, j (d, 1) ∈ U → c ∉ K → j (d, c) ∈ W ∧ f (j (d, c)) = F c) (hlt : ∫⁻ g in W, f g ∂μ < μ U) :
    ∫⁻ c in Kᶜ, F c ∂μC < μC K := by
  let μD : Measure D := Measure.haar
  let T : Set D := {d | j (d, 1) ∈ U}
  have oT : IsOpen T := hU.preimage (j.continuous.comp (by fun_prop))
  have m1 : (1 : D) ∈ T := by
    show j ((1 : D), (1 : C)) ∈ U; rw [show ((1 : D), (1 : C)) = 1 from rfl, map_one]; exact h1
  have t0 : μD T ≠ 0 := (oT.measure_pos μD ⟨1, m1⟩).ne'
  have tt : μD T ≠ ⊤ := ((measure_mono (show T ⊆ Prod.fst '' (j.symm '' U) from fun d hd =>
    ⟨(d, 1), ⟨j (d, 1), hd, j.symm_apply_apply _⟩, rfl⟩)).trans_lt
    ((hUc.image j.symm.continuous).image continuous_fst).measure_lt_top).ne
  let P : Measure (D × C) := μD.prod μC
  have me : MeasurableEmbedding j := j.toHomeomorph.measurableEmbedding
  have hH : (P.map j).IsHaarMeasure := j.toMulEquiv.isHaarMeasure_map P j.continuous j.symm.continuous
  have hν : P.map j = Measure.haarScalarFactor (P.map j) μ • μ := Measure.isMulLeftInvariant_eq_smul (P.map j) μ
  have a1 : μD T * ∫⁻ c in Kᶜ, F c ∂μC = ∫⁻ y in T ×ˢ Kᶜ, F y.2 ∂P := by
    rw [← Measure.prod_restrict, lintegral_prod (fun y : D × C => F y.2) (hF.comp measurable_snd).aemeasurable]
    simp [lintegral_const, mul_comm]
  have a2 : ∫⁻ y in T ×ˢ Kᶜ, F y.2 ∂P ≤ ∫⁻ g in W, f g ∂(P.map j) := by
    rw [me.restrict_map, me.lintegral_map]
    exact (setLIntegral_congr_fun (oT.measurableSet.prod hK.compl) fun y hy => (hm y.1 y.2 hy.1 hy.2).2.symm).trans_le
      (lintegral_mono_set fun y hy => (hm _ _ hy.1 hy.2).1)
  have a3 : (P.map j) U ≤ μD T * μC K := by
    rw [me.map_apply, ← Measure.prod_prod]; exact measure_mono fun y hy => hc y.1 y.2 hy
  have a4 : ∫⁻ g in W, f g ∂(P.map j) < (P.map j) U := by
    rw [hν, Measure.restrict_smul, lintegral_smul_measure, smul_apply]
    have hk : ((Measure.haarScalarFactor (P.map j) μ : ℝ≥0) : ENNReal) ≠ 0 := by
      exact_mod_cast (Measure.haarScalarFactor_pos_of_isHaarMeasure (P.map j) μ).ne'
    simp only [ENNReal.smul_def, smul_eq_mul]; exact (ENNReal.mul_lt_mul_iff_right hk ENNReal.coe_ne_top).2 hlt
  exact (ENNReal.mul_lt_mul_iff_right t0 tt).1 ((a1.le.trans a2).trans_lt (a4.trans_le a3))

theorem tail_k : Tools_k → Tail_k := by
  intro T F E _ _ _ _ _ σ B n X hB hX K a e hK ha he μ t hμ hi S₀
  have := _root_.GlobalTheory.AdelicUnitaryTop.countable_heightOneSpectrum F
  obtain ⟨a1, a2, a3⟩ := Euler.lcsc_UA σ X.J
  have dec := decomp_k T F E σ B n X hB hX
  let U : Set (UA σ X.J) := {g | IntAll g}
  have Um : ∀ {x y : UA σ X.J}, IntAll x → IntAll y → IntAll (x * y) := fun hx hy v =>
    (Euler.intGrp σ X v).mul_mem (hx v) (hy v)
  have Ui : ∀ {x : UA σ X.J}, IntAll x → IntAll x⁻¹ := fun hx v => (Euler.intGrp σ X v).inv_mem (hx v)
  have U1 : IntAll (1 : UA σ X.J) := fun v => (Euler.intGrp σ X v).one_mem
  obtain ⟨-, -, -, -, cU, oU, -, -, -⟩ := dec ∅
  have hr : ∀ g u : UA σ X.J, IntAll u → a (e (g * u, 1)) = a (e (g, 1)) := fun g u hu => by
    rw [show e (g * u, 1) = e (g, 1) * e (u, 1) by rw [← map_mul, Prod.mk_mul_mk, mul_one]]
    obtain ⟨p, t', hp, k', hk', heq⟩ := ha.iwa (e (g, 1))
    rw [heq, mul_assoc, ha.val p t' hp _ (K.mul_mem hk' (Bad.emb_mem_k hB hX (by simp) hK he hu)),
      ha.val p t' hp k' hk']
  have lc : IsLocallyConstant fun g : UA σ X.J => a (e (g, 1)) := (IsLocallyConstant.iff_exists_open _).2 fun g =>
    ⟨{x | g⁻¹ * x ∈ U}, oU.preimage (by fun_prop), by show g⁻¹ * g ∈ U; rw [inv_mul_cancel]; exact U1,
      fun x hx => by have := hr g _ hx; rwa [mul_inv_cancel_left] at this⟩
  let f : UA σ X.J → ENNReal := fun g => ENNReal.ofReal (a (e (g, 1)) ^ t)
  have cf : Continuous f := (lc.comp fun r => ENNReal.ofReal (r ^ t)).continuous
  let m : Measure (UA σ X.J) := μ.withDensity f
  have mfin : m Set.univ ≠ ⊤ := by
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]; exact hi.lintegral_lt_top.ne
  let A : Finset (Pl F) → Set (UA σ X.J) := fun S => {g | ∀ v ∈ S, IntAt v g} \ U
  have mA : ∀ S, MeasurableSet (A S) := fun S => MeasurableSet.diff (by
    simp only [Set.ofPred_forall]
    exact (isClosed_iInter fun u => isClosed_iInter fun _ => Euler.isClosed_int hX.lat.toIsLattice u).measurableSet)
      oU.measurableSet
  have emp : ⋂ S, A S = ∅ := Set.eq_empty_of_forall_notMem fun g hg =>
    (Set.mem_iInter.1 hg ∅).2 fun v => (Set.mem_iInter.1 hg {v}).1 v (Finset.mem_singleton_self v)
  have anti : Antitone A := fun _ _ hS _ hg => ⟨fun v hv => hg.1 v (hS hv), hg.2⟩
  have ten := tendsto_measure_iInter_atTop (μ := m) (fun S => (mA S).nullMeasurableSet) anti
    ⟨∅, ne_top_of_le_ne_top mfin (measure_mono (Set.subset_univ _))⟩
  rw [emp, measure_empty] at ten
  obtain ⟨S, hlt, hS⟩ := ((ten.eventually (gt_mem_nhds (oU.measure_pos μ ⟨1, U1⟩))).and (eventually_ge_atTop S₀)).exists
  refine ⟨S, hS, fun μC hC => ?_⟩
  obtain ⟨⟨j, hj⟩, cI, cA, cO, -, -, iI, -, -⟩ := dec S
  have : LocallyCompactSpace (gInf σ X) := cI.isClosed.isClosedEmbedding_subtypeVal.locallyCompactSpace
  have : LocallyCompactSpace (gAt σ X S) := cA.isClosedEmbedding_subtypeVal.locallyCompactSpace
  have : LocallyCompactSpace (gOff σ X S) := cO.isClosedEmbedding_subtypeVal.locallyCompactSpace
  have : SecondCountableTopology (gInf σ X) := IsEmbedding.subtypeVal.secondCountableTopology
  have : SecondCountableTopology (gAt σ X S) := IsEmbedding.subtypeVal.secondCountableTopology
  have : SecondCountableTopology (gOff σ X S) := IsEmbedding.subtypeVal.secondCountableTopology
  let j' : (gInf σ X × gAt σ X S) × gOff σ X S ≃ₜ* UA σ X.J :=
    { toMulEquiv := MulEquiv.prodAssoc.trans j.toMulEquiv,
      continuous_toFun := j.continuous.comp ((continuous_fst.comp continuous_fst).prodMk
        ((continuous_snd.comp continuous_fst).prodMk continuous_snd)),
      continuous_invFun := ((continuous_fst.prodMk (continuous_fst.comp continuous_snd)).prodMk
        (continuous_snd.comp continuous_snd)).comp j.symm.continuous }
  have hj' : ∀ d c, j' (d, c) = d.1.1 * d.2.1 * c.1 := fun d c => hj (d.1, d.2, c)
  have hj1 : ∀ d, j' (d, 1) = d.1.1 * d.2.1 := fun d => by rw [hj']; simp
  have hcm : ∀ d c, j' (d, c) = c.1 * (d.1.1 * d.2.1) := fun d c => by
    have := map_mul j' ((1 : gInf σ X × gAt σ X S), c) (d, (1 : gOff σ X S))
    rw [Prod.mk_mul_mk, one_mul, mul_one, hj1] at this; rw [this, hj']; simp
  have intOff : ∀ {v : Pl F} {c : UA σ X.J}, c ∈ gOff σ X S → v ∈ S → IntAt v c := fun {v} _ hc hv =>
    (show gOff σ X S ≤ Euler.intGrp σ X v from (Subgroup.closure_le _).2 fun g hg z hz h => by
      have h0 : PositivityTheory.ThKG.Loc.idem F v • (mat g - 1) = 0 := Matrix.ext fun i j => Bad.idem_off (by
        have := congrFun₂ (hg.2 v hv) i j; rw [Matrix.map_apply] at this
        simp [this, Matrix.one_apply, apply_ite (compFin F E v)])
      have e : mat g *ᵥ z = z := by
        have : (mat g - 1) *ᵥ z = 0 := by
          rw [← Bad.idem_smul h, Matrix.mulVec_smul, ← Matrix.smul_mulVec, h0, Matrix.zero_mulVec]
        rwa [Matrix.sub_mulVec, Matrix.one_mulVec, sub_eq_zero] at this
      have e' : mat g⁻¹ *ᵥ z = z := by
        conv_lhs => rw [← e]; rw [Matrix.mulVec_mulVec, ← Euler.mm, inv_mul_cancel]; exact Matrix.one_mulVec z
      exact ⟨e.symm ▸ hz, e'.symm ▸ hz⟩) hc
  have intAt : ∀ {v : Pl F} {b : UA σ X.J}, b ∈ gAt σ X S → v ∉ S → IntAt v b := fun {v} _ hb hv =>
    (show gAt σ X S ≤ Euler.intGrp σ X v from iSup₂_le fun w hw _ hx => by
      have hvw : v ≠ w := fun e => hv (e ▸ hw)
      have := (Euler.int_mul_ne hvw hx 1).2 (Euler.intGrp σ X v).one_mem; rwa [mul_one] at this) hb
  exact abs_tail_pk j' μ μC (U := U) (W := A S) (K := {c | IntAll c.1}) oU cU U1
    (oU.preimage continuous_subtypeVal).measurableSet f (fun c => f c.1) (cf.measurable.comp measurable_subtypeVal)
    (fun d c hg => by
      have hx := iI _ d.1.2; have hg' : IntAll (d.1.1 * d.2.1 * c.1) := hj' d c ▸ hg
      have hb : IntAll d.2.1 := fun v => by
        by_cases hv : v ∈ S
        · rw [show d.2.1 = d.1.1⁻¹ * (d.1.1 * d.2.1 * c.1) * c.1⁻¹ by group]
          exact (Euler.intGrp σ X v).mul_mem ((Euler.intGrp σ X v).mul_mem ((Euler.intGrp σ X v).inv_mem (hx v)) (hg'
            v))
            ((Euler.intGrp σ X v).inv_mem (intOff c.2 hv))
        · exact intAt d.2.2 hv
      have hxb := Um hx hb
      exact ⟨hj1 d ▸ hxb, by
        show IntAll c.1; rw [show c.1 = (d.1.1 * d.2.1)⁻¹ * (d.1.1 * d.2.1 * c.1) by group]; exact Um (Ui hxb) hg'⟩)
    (fun d c hd hcK => by
      have hd' : IntAll (d.1.1 * d.2.1) := hj1 d ▸ hd
      refine ⟨⟨fun v hv => hj' d c ▸ (Euler.intGrp σ X v).mul_mem (hd' v) (intOff c.2 hv), fun hg => hcK (by
        show IntAll c.1; rw [show c.1 = (d.1.1 * d.2.1)⁻¹ * (d.1.1 * d.2.1 * c.1) by group];
          exact Um (Ui hd') (hj' d c ▸ hg))⟩,
        by show ENNReal.ofReal (a (e (j' (d, c), 1)) ^ t) = ENNReal.ofReal (a (e (c.1, 1)) ^ t); rw [hcm, hr _ _ hd']⟩)
    (by rwa [← withDensity_apply _ (mA S)])

theorem readLift_k : Tools_k → LiftAut_k → AbsIso → ReadLift_k := by
  intro T hL hA E _ _ _ B n d X W M χX χW om hP hn e e' he he' U U' pr hU hU' hp f₀ hf₀ φ hφ φf hfin hne
  obtain ⟨Θ, hΘ⟩ := hL E B n d X W M χX χW om hP hn e e' he he'
  have pmem : ∀ {f : SInf (maximalRealSubfield E) (Fin n × Fin d)} {ψ : ∀ v : Pl (maximalRealSubfield E),
      (Fin n × Fin d → Fv (maximalRealSubfield E) v) → ℂ}, f ∈ M.Pol B.ψ B.emb → IsFin M ψ → pWT f ψ ∈ PolData B M :=
    fun hf h => Submodule.subset_span ⟨_, hf, _, h.1, h.2, rfl⟩
  have stdf : ∀ {ψ : ∀ v : Pl (maximalRealSubfield E), (Fin n × Fin d → Fv (maximalRealSubfield E) v) → ℂ},
      IsFin M ψ → ∀ᶠ v in cofinite, ψ v = Set.indicator {x | ∀ i, x i ∈ v.adicCompletionIntegers (maximalRealSubfield
        E)} 1 :=
    fun h => by filter_upwards [h.2, hP.good.std] with _ a b using a.trans b
  let Φ₀ : PolData B M := ⟨pWT f₀ φf, pmem hf₀ hfin⟩
  have hne' : pr (Θ Φ₀ φ) ≠ 0 := by rw [(hΘ Φ₀ φ (hU.aut φ hφ)).1]; exact hne
  constructor
  · intro w lam' ⟨hirr, i, hi, ⟨x₀, hx₀⟩, hact⟩
    let Ψ : nablaSq ℂ d lam' → PolData B M := fun x => ⟨pWT (i x) φf, pmem (hi x) hfin⟩
    have hadd : ∀ x y, Ψ (x + y) = Ψ x + Ψ y := fun x y => Subtype.ext (funext fun _ => by
      change pWT (i (x + y)) φf _ = pWT (i x) φf _ + pWT (i y) φf _
      simp [pWT, GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.pure, add_mul])
    have hsm : ∀ (a : ℂ) x, Ψ (a • x) = a • Ψ x := fun a x => Subtype.ext (funext fun _ => by
      change pWT (i (a • x)) φf _ = a * pWT (i x) φf _
      simp [pWT, GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.pure, mul_assoc])
    have hφA := hU.aut φ hφ
    refine ⟨hirr,
      { toFun := fun x => pr (Θ (Ψ x) φ),
        map_add' := fun _ _ => (by simp only [hadd, map_add (f := _), LinearMap.add_apply]),
        map_smul' := fun _ _ => (by simp only [hsm, map_smul, LinearMap.smul_apply, RingHom.id_apply]) },
      fun h0 => hne' (by
        have h2 : Ψ x₀ = Φ₀ := Subtype.ext (by change pWT (i x₀) φf = pWT f₀ φf; rw [hx₀])
        simpa [h2] using LinearMap.congr_fun h0 x₀),
      fun _ => (hp _ (hΘ _ _ hφA).2.1).1, fun k x => ?_⟩
    obtain ⟨Φ₁, h1, h2⟩ := (hΘ (Ψ x) φ hφA).2.2 1 k.1
    have e1 : Φ₁ = Ψ (GlobalTheory.Branching.sqRep ℂ d lam' (cEmb (B.emb w).1 k.1) x) := Subtype.ext (by
      rw [h1, map_one]; exact PositivityTheory.ThKG.Loc.Cone.pure_real (hact k.1 k.2 x) φf hfin.1 (stdf hfin))
    rw [map_one, one_apply_eq_self, e1] at h2
    change pr (Θ (Ψ _) φ) = RU E d k.1 (pr (Θ (Ψ x) φ))
    rw [← (hp _ (hΘ (Ψ x) φ hφA).2.1).2 k.1, ← h2]; rfl
  · intro v t τ τ' ⟨hirr, f, hf0, hfU, hfe⟩ ⟨hirr', f', hf0', hfU', hfe'⟩
    have hc := hP.base.cm
    let w := splitPrime t
    have hw : IsSplitAt w := ⟨splitPrime (t.comp (cj E)), splitPrime_comp_ne hc t, by
      rw [splitPrime_under, splitPrime_under]⟩
    have csurj : ∀ a, Function.Surjective ((cLoc (n := a) w).comp (locU a w).subtype) := fun a g => by
      obtain ⟨eqv, heqv⟩ := GlobalTheory.locU_equiv_GL E a w hw
      exact ⟨eqv.symm g, by rw [MonoidHom.comp_apply, Subgroup.coe_subtype, ← heqv, eqv.apply_symm_apply]⟩
    have dloc : ∀ a (g : GlobalTheory.UnitaryBC.UA E a), ∃ h ∈ locU a w, ∀ h' ∈ locU a w, Commute (h⁻¹ * g) h' :=
      fun a g => by
      obtain ⟨x, hx, _, rfl, hy⟩ := GlobalTheory.Cong.exists_locU_mul_comm a w hw g
      exact ⟨x, hx, fun z hz => by rw [inv_mul_cancel_left]; exact hy z hz⟩
    have ipull : ∀ {G H V : Type} [Group G] [Group H] [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ G V)
        (q : H →* G), Function.Surjective q → ρ.IsIrreducible → Representation.IsIrreducible (ρ.comp q : Representation
          ℂ H V) :=
      fun ρ q hq h => (GlobalTheory.CuspRep.isIrreducible_iff _).2 ⟨((GlobalTheory.CuspRep.isIrreducible_iff _).1 h).1,
        fun U₀ hU₀ => ((GlobalTheory.CuspRep.isIrreducible_iff _).1 h).2 U₀ fun g v hv => by
          obtain ⟨x, rfl⟩ := hq g; exact hU₀ x v hv⟩
    let P : (GlobalTheory.UnitaryBC.UA E n → ℂ) →+ (GlobalTheory.UnitaryBC.UA E d → ℂ) :=
      { toFun := fun y => pr (Θ Φ₀ y), map_zero' := by simp, map_add' := fun _ _ => by simp }
    obtain ⟨⟨m, cs, xs, hcsU, hcse, hsum⟩, -⟩ := hA (GlobalTheory.UnitaryBC.UA E n) (GlobalTheory.UnitaryBC.UA E n → ℂ)
      τ.V (RU E n) U (locU n w) (τ.ρ.comp ((cLoc w).comp (locU n w).subtype)) (dloc n) hU.stable hU.irred
      (ipull _ _ (csurj n) hirr) f hf0 hfU hfe φ hφ
    obtain ⟨p, hp0, hpe⟩ := (hA (GlobalTheory.UnitaryBC.UA E d) (GlobalTheory.UnitaryBC.UA E d → ℂ) τ'.V (RU E d) U'
      (locU d w) (τ'.ρ.comp ((cLoc w).comp (locU d w).subtype)) (dloc d) hU'.stable hU'.irred
      (ipull _ _ (csurj d) hirr') f' hf0' hfU' hfe' (P φ) (hp _ (hΘ _ _ (hU.aut φ hφ)).2.1).1).2 hne'
    obtain ⟨idx, -, hp0'⟩ := Finset.exists_ne_zero_of_sum_ne_zero (show ∑ i, p (P (cs i (xs i))) ≠ 0 by
      rw [← map_sum, ← map_sum, ← hsum]; exact hp0)
    let c := cs idx; let x₀ := xs idx
    have hcU := hcsU idx; have hce := hcse idx
    obtain ⟨⟨ι, hι⟩, hSM⟩ := T.split _ E (cj E) B n d X W M χX χW om n 0 d 0 hP v t
    have hSM := hSM ι hι
    have hbij := Model.IsLin.bij hι
    let ιe : SB (Fin n × Fin d → Fv (maximalRealSubfield E) v) ≃ₗ[ℂ]
        SB (Matrix (Fin n) (Fin d) (Fv (maximalRealSubfield E) v)) :=
      LinearEquiv.ofBijective (ι.restrict fun _ hy => hbij.mapsTo hy)
        ⟨fun a b h => Subtype.ext (hbij.injOn a.2 b.2 (congrArg Subtype.val h)),
         fun b => by obtain ⟨a, ha, hab⟩ := hbij.surjOn b.2; exact ⟨⟨a, ha⟩, Subtype.ext hab⟩⟩
    have hfu : ∀ ψ : SB (Fin n × Fin d → Fv (maximalRealSubfield E) v), IsFin M (Function.update φf v ψ.1) := fun ψ =>
      ⟨fun u => by
         by_cases hu : u = v
         · subst hu; simp
         · simpa [Function.update_of_ne hu] using hfin.1 u,
       by filter_upwards [hfin.2, Filter.eventually_cofinite_ne v] with _ hu hne''; rwa [Function.update_of_ne hne'']⟩
    let Ψ : SB (Fin n × Fin d → Fv (maximalRealSubfield E) v) → PolData B M :=
      fun ψ => ⟨pWT f₀ (Function.update φf v ψ.1), pmem hf₀ (hfu ψ)⟩
    have hPA := PositivityTheory.ThKF.pureAct (maximalRealSubfield E) (Fin n × Fin d) v id f₀ φf hfin.1 (stdf hfin)
    have hz : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.pure f₀ (Function.update φf v 0) = 0 :=
      PositivityTheory.ThKG.Loc.Cone.pure_zero f₀ _
        (GlobalTheory.PureFactor.update_eventually φf v 0 (stdf hfin)) v (by simp)
    have hadd : ∀ a b, Ψ (a + b) = Ψ a + Ψ b := fun a b => Subtype.ext (by
      have := hPA.2.1 a.1 b.1 1; rwa [one_smul, one_smul] at this)
    have hsm : ∀ (r : ℂ) a, Ψ (r • a) = r • Ψ a := fun r a => Subtype.ext (by
      have := hPA.2.1 0 a.1 r; rwa [zero_add, hz, zero_add] at this)
    let A : SB (Fin n × Fin d → Fv (maximalRealSubfield E) v) →ₗ[ℂ] τ.V →ₛₗ[starRingEnd ℂ] τ'.V :=
      LinearMap.mk₂'ₛₗ (RingHom.id ℂ) (starRingEnd ℂ) (fun ψ x => p (pr (Θ (Ψ ψ) (c x))))
        (fun _ _ _ => by simp only [hadd, map_add (f := _), LinearMap.add_apply])
        (fun _ _ _ => by simp only [hsm, map_smul, LinearMap.smul_apply, RingHom.id_apply])
        (fun _ _ _ => by simp only [map_add (f := _)]) (fun _ _ _ => by simp only [map_smul, map_smulₛₗ])
    have rpt : ∀ {a : ℕ} {Y : Spc (maximalRealSubfield E) E a} {ε : GlobalTheory.UnitaryBC.UA E a ≃ₜ* UA (cj E) Y.J},
        IsBr Y ε → ∀ g : GL (Fin a) (Fv (maximalRealSubfield E) v),
        ∃ x : locU a w, ε x.1 ∈ UAt (cj E) Y (evFin (maximalRealSubfield E) v) ∧ g.1 = (mat (ε x.1)).map (piW t) ∧
          cLoc w x.1 = Matrix.GeneralLinearGroup.map (complMap (splitPrime_under t)) g := fun {a} _ _ hε g => by
      obtain ⟨x, hx⟩ := csurj a (Matrix.GeneralLinearGroup.map (complMap (splitPrime_under t)) g)
      have hx' : cLoc w x.1 = Matrix.GeneralLinearGroup.map (complMap (splitPrime_under t)) g := hx
      refine ⟨x, ?_, ?_, hx'⟩
      · have h1 := (hε.loc w x.1).2 x.2; rw [splitPrime_under] at h1; exact GlobalTheory.ThK.Dbl.Inert.mem_locGrp h1
      · have h1 := hε.spl v t x.1; rw [hx'] at h1
        exact Matrix.map_injective (complMap (splitPrime_under t)).injective h1.symm
    refine ⟨A ∘ₗ ιe.symm.toLinearMap, fun h0 => hp0' (by
        have h2 : Ψ ⟨φf v, hfin.1 v⟩ = Φ₀ := Subtype.ext (by
          change pWT f₀ (Function.update φf v (φf v)) = pWT f₀ φf; rw [Function.update_eq_self])
        simpa [A, h2, P] using LinearMap.congr_fun (LinearMap.congr_fun h0 (ιe ⟨φf v, hfin.1 v⟩)) x₀),
      fun g h Φ Φ₁ hΦ x => ?_⟩
    obtain ⟨ĝ, hg1, hg2, hg3⟩ := rpt he g; obtain ⟨ĥ, hh1, hh2, hh3⟩ := rpt he' h
    set ψ := ιe.symm Φ
    obtain ⟨ψ₁, ⟨hψ₁, hact⟩, -⟩ := (T.acts _ E (cj E) B n d X W M χX χW om n 0 d 0 hP v).1 _ hg1 _ hh1 ψ.1 ψ.2
    have hι₁ : ι ψ₁ = Φ₁.1 := by
      rw [hΦ, ← congrArg Subtype.val (ιe.apply_symm_apply Φ)]; exact hSM _ hg1 _ hh1 g h hg2 hh2 _ ψ.2 _ hψ₁ hact
    have hψ₁' : ιe.symm Φ₁ = ⟨ψ₁, hψ₁⟩ := by rw [LinearEquiv.symm_apply_eq]; exact Subtype.ext hι₁.symm
    have hΦ₁ := hΘ (Ψ ψ) (c x) (hU.aut _ (hcU x))
    obtain ⟨Φ₂, h1, h2⟩ := hΦ₁.2.2 ĝ.1 ĥ.1
    have hΦ₂ : Φ₂ = Ψ ⟨ψ₁, hψ₁⟩ := Subtype.ext (by
      rw [h1]
      have := (PositivityTheory.ThKF.pureAct (maximalRealSubfield E) (Fin n × Fin d) v (om (e ĝ.1, e' ĥ.1)) f₀
        (Function.update φf v ψ.1) (hfu ψ).1 (stdf (hfu ψ))).2.2 ψ₁ (by simpa using hact)
      refine this.trans ?_
      change pWT f₀ (Function.update (Function.update φf v ψ.1) v ψ₁) = pWT f₀ (Function.update φf v ψ₁)
      rw [Function.update_idem])
    have hce' : ∀ (k : locU n w) (x : τ.V), c (τ.ρ (cLoc w k.1) x) = RU E n k.1 (c x) := hce
    have hpe' : ∀ (k : locU d w) (y : GlobalTheory.UnitaryBC.UA E d → ℂ),
        y ∈ U' → p (RU E d k.1 y) = τ'.ρ (cLoc w k.1) (p y) := hpe
    change p (pr (Θ (Ψ (ιe.symm Φ₁)) (c (τ.ρ _ x)))) = τ'.ρ _ (p (pr (Θ (Ψ ψ) (c x))))
    rw [hψ₁', ← hΦ₂, ← hg3, ← hh3, hce' ĝ x, h2, (hp _ hΦ₁.2.1).2, hpe' ĥ _ (hp _ hΦ₁.2.1).1]

end UpperTheory.TP
