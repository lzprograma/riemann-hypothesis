    rcases hI (LinearMap.ker j) (fun g _ hw => by
      show j (ρ (p g) _) = 0; rw [hR, show j _ = 0 from hw, map_zero]) with h1 | h1
    · exact (Submodule.mem_bot ℂ).1 (h1 ▸ (ha : a ∈ LinearMap.ker j))
    · exact absurd ((LinearMap.mem_ker.1 (h1 ▸ trivial : x₀ ∈ LinearMap.ker j)).symm.trans hj |>.symm) hφ
  let f : V →ₗ[ℂ] (UA (cj E) X.J → ℂ) := (LinearMap.funLeft ℂ ℂ e.symm).comp j
  have hf0 : ∀ a, f a = 0 → a = 0 := fun a ha => hj0 a (funext fun y => by
    have := congrFun ha (e y); rwa [show f a (e y) = j a (e.symm (e y)) from rfl, e.symm_apply_apply] at this)
  have h2 : ∀ᶠ v in cofinite, φf v = Set.indicator {x | ∀ i, x i ∈ HeightOneSpectrum.adicCompletionIntegers _ v} 1 :=
    (hfin.2.and P.good.std).mono fun _ h => h.1.trans h.2
  have hrest := fun s => PositivityTheory.ThKG.Loc.Bump.rest_pure s φf hfin.1 h2
  let Ψ : V →ₗ[ℂ] ((Fin n × Fin d → AF (maximalRealSubfield E)) → ℂ) :=
    { toFun := fun a => pWT (i a) φf,
      map_add' := fun _ _ => funext fun _ => by
        simp [pWT, GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.pure, add_mul],
      map_smul' := fun _ _ => funext fun _ => by
        simp [pWT, GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.pure, mul_assoc] }
  have hact : ∀ x a, om (x.1, 1) (Ψ a) = Ψ (π x a) := fun x a => by have h := hA (p x) a _ (hrest (i a)); rwa [hpe] at h
  have hsp := IsUWeilPair.isUSplitting P.weil
  let B₁ : V →ₗ[ℂ] V →ₗ⋆[ℂ] ℂ := LinearMap.mk₂'ₛₗ (RingHom.id ℂ) (starRingEnd ℂ)
    (fun a b => lD _ (Fin n × Fin d) (boxFun (Ψ a) (star (Ψ b))))
    (fun _ _ _ => by rw [map_add (f := _), GlobalTheory.SchwartzBox.boxFun_add_left, map_add (f := _)])
    (fun _ _ _ => by rw [map_smul, GlobalTheory.SchwartzBox.boxFun_smul_left, map_smul]; rfl)
    (fun _ _ _ => by rw [map_add (f := _), star_add, GlobalTheory.SchwartzBox.boxFun_add_right, map_add (f := _)])
    (fun _ _ _ => by rw [map_smul, star_smul, GlobalTheory.SchwartzBox.boxFun_smul_right, map_smul]; rfl)
  have hB₁ : ∀ g a b, B₁ (π g a) (π g b) = B₁ a b := fun g a b => by
    change lD _ _ (boxFun (Ψ (π g a)) (star (Ψ (π g b)))) = lD _ _ (boxFun (Ψ a) (star (Ψ b)))
