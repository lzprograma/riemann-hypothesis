private theorem assemble_pk {H A V : Type} [Group H] [TopologicalSpace H] [IsTopologicalGroup H] [MeasurableSpace H]
    [BorelSpace H] (μ : Measure H) [μ.IsMulLeftInvariant] [μ.IsMulRightInvariant] [μ.IsOpenPosMeasure] (Γ : Subgroup H)
    [Countable Γ] (𝓕 : Set H) (h𝓕 : IsFundamentalDomain Γ 𝓕 μ) (hfin : μ 𝓕 < ⊤) (Ω : Set H) (hΩ : IsCompact Ω)
    (hcov : ∀ g, ∃ γ ∈ Γ, γ * g ∈ Ω) [Group A] [MeasurableSpace A] [MeasurableMul A] (μA : Measure A)
    [IsFiniteMeasure μA] [μA.IsMulLeftInvariant] [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V] [Nontrivial V]
    (π : A →* Module.End ℂ V) (hI : ∀ W : Submodule ℂ V, (∀ g, ∀ w ∈ W, π g w ∈ W) → W = ⊥ ∨ W = ⊤) (ι : A →* H)
    (hι : Measurable ι) (f : V →ₗ[ℂ] (H → ℂ)) (hf0 : ∀ a, f a = 0 → a = 0) (hfc : ∀ a, Continuous (f a))
    (hfl : ∀ a, ∀ γ ∈ Γ, ∀ h, f a (γ * h) = f a h) (hfr : ∀ x a y, f (π x a) y = f a (y * ι x))
    (B₁ : V →ₗ[ℂ] V →ₗ⋆[ℂ] ℂ) (hB₁ : ∀ g a b, B₁ (π g a) (π g b) = B₁ a b) (x₀ : V) (u : H → ℂ) (huc : Continuous u)
    (hul : ∀ γ ∈ Γ, ∀ h, u (γ * h) = u h) :
    ∫ x, B₁ (π x x₀) x₀ * star (pet μ 𝓕 (fun y => u (y * ι x)) (f x₀)) ∂μA =
      ((μA.real Set.univ / (Module.finrank ℂ V : ℝ) : ℝ) : ℂ) * B₁ x₀ x₀ * star (pet μ 𝓕 u (f x₀)) := by
  have P := UpperTheory.innerProduct_integral_fundamentalDomain_of_compact μ Γ 𝓕 h𝓕 hfin Ω hΩ hcov
  have addL : ∀ g₁ g₂ g₃ : H → ℂ, Continuous g₁ → Continuous g₂ → Continuous g₃ → (∀ γ ∈ Γ, ∀ h, g₁ (γ * h) = g₁ h) →
      (∀ γ ∈ Γ, ∀ h, g₂ (γ * h) = g₂ h) → (∀ γ ∈ Γ, ∀ h, g₃ (γ * h) = g₃ h) →
      pet μ 𝓕 (g₁ + g₂) g₃ = pet μ 𝓕 g₁ g₃ + pet μ 𝓕 g₂ g₃ := fun _ _ _ c1 c2 c3 l1 l2 l3 => by
    simp only [pet, Pi.add_apply, add_mul]; exact integral_add (P _ _ c1 c3 l1 l3).1 (P _ _ c2 c3 l2 l3).1
  have addR : ∀ g₁ g₂ g₃ : H → ℂ, Continuous g₁ → Continuous g₂ → Continuous g₃ → (∀ γ ∈ Γ, ∀ h, g₁ (γ * h) = g₁ h) →
      (∀ γ ∈ Γ, ∀ h, g₂ (γ * h) = g₂ h) → (∀ γ ∈ Γ, ∀ h, g₃ (γ * h) = g₃ h) →
      pet μ 𝓕 g₃ (g₁ + g₂) = pet μ 𝓕 g₃ g₁ + pet μ 𝓕 g₃ g₂ := fun _ _ _ c1 c2 c3 l1 l2 l3 => by
    simp only [pet, Pi.add_apply, star_add, mul_add]; exact integral_add (P _ _ c3 c1 l3 l1).1 (P _ _ c3 c2 l3 l2).1
  have smL : ∀ (c : ℂ) (g₁ g₂ : H → ℂ), pet μ 𝓕 (c • g₁) g₂ = c * pet μ 𝓕 g₁ g₂ := fun _ _ _ => by
    simp only [pet, Pi.smul_apply, smul_eq_mul, mul_assoc]; exact integral_const_mul _ _
  have smR : ∀ (c : ℂ) (g₁ g₂ : H → ℂ), pet μ 𝓕 g₁ (c • g₂) = starRingEnd ℂ c * pet μ 𝓕 g₁ g₂ := fun c _ _ => by
    simp only [pet, Pi.smul_apply, smul_eq_mul, star_mul', mul_left_comm _ (star c)]
    exact integral_const_mul (star c) _
  let B : V →ₗ[ℂ] V →ₗ⋆[ℂ] ℂ := LinearMap.mk₂'ₛₗ (RingHom.id ℂ) (starRingEnd ℂ) (fun a b => pet μ 𝓕 (f a) (f b))
    (fun a b c => by rw [map_add (f := _)]; exact addL _ _ _ (hfc a) (hfc b) (hfc c) (hfl a) (hfl b) (hfl c))
    (fun _ _ _ => by rw [map_smul]; exact smL _ _ _)
    (fun a b c => by rw [map_add (f := _)]; exact addR _ _ _ (hfc b) (hfc c) (hfc a) (hfl b) (hfl c) (hfl a))
    (fun _ _ _ => by rw [map_smul]; exact smR _ _ _)
  have hh : ∀ a b, B b a = star (B a b) := fun a b => by
    change pet μ 𝓕 (f b) (f a) = starRingEnd ℂ (pet μ 𝓕 (f a) (f b))
    simp only [pet, ← integral_conj]; congr 1; funext _; simp [mul_comm]
  have hp : ∀ a, a ≠ 0 → 0 < (B a a).re := fun a ha => (P _ _ (hfc a) (hfc a) (hfl a) (hfl a)).2.2 fun h => ha (hf0 a h)
  have hinv : ∀ g a b, B (π g a) (π g b) = B a b := fun g a b => by
    change pet μ 𝓕 (f (π g a)) (f (π g b)) = pet μ 𝓕 (f a) (f b)
    simp only [pet, hfr]; exact (P _ _ (hfc a) (hfc b) (hfl a) (hfl b)).2.1 (ι g)
  obtain ⟨c', hc'⟩ := UpperTheory.invariant_sesquilinearForm_eq_smul_of_irreducible π hI B hh hp hinv B₁ hB₁
  let L : V →ₗ⋆[ℂ] ℂ :=
    { toFun := fun b => pet μ 𝓕 u (f b)
      map_add' := fun a b => by rw [map_add (f := _)]; exact addR _ _ _ (hfc a) (hfc b) huc (hfl a) (hfl b) hul
      map_smul' := fun _ _ => by rw [map_smul]; exact smR _ _ _ }
  obtain ⟨u₀, hu₀⟩ := _root_.UpperTheory.Reformulated.B.Qh51.riesz_representation_sesquilinear B hh hp L
  have key : ∀ x, pet μ 𝓕 (fun y => u (y * ι x)) (f x₀) = B (π x u₀) x₀ := fun x => by
    have e1 := (P (fun y => u (y * ι x)) (f x₀) (huc.comp (continuous_mul_const _)) (hfc x₀)
      (fun γ hγ _ => by simp only [mul_assoc, hul γ hγ]) (hfl x₀)).2.1 (ι x⁻¹)
    have e2 : ∀ h, f x₀ (h * ι x⁻¹) = f (π x⁻¹ x₀) h := fun _ => (hfr _ _ _).symm
    have e3 : ∀ h, u (h * ι x⁻¹ * ι x) = u h := fun _ => by rw [mul_assoc, ← map_mul, inv_mul_cancel, map_one, mul_one]
    simp only [e2, e3] at e1; rw [pet]; simp only [RCLike.star_def]; rw [← e1]
    simp only [← RCLike.star_def]
    change pet μ 𝓕 u (f (π x⁻¹ x₀)) = _
    rw [show pet μ 𝓕 u (f (π x⁻¹ x₀)) = B u₀ (π x⁻¹ x₀) from hu₀ _, ← hinv x u₀]
    congr 1; rw [← mul_apply_eq_comp, ← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]
  have hm : ∀ a b, Measurable fun g => B (π g a) b := fun a b =>
    _root_.UpperTheory.Reformulated.B.Qk65.measurable_of_separating_functionals (fun y => (LinearMap.proj y).comp f) (fun _ h => hf0 _ (funext h))
      (fun g => π g a)
      (fun y => by
        show Measurable fun g => f (π g a) y; simp only [hfr]; exact (hfc a).measurable.comp ((measurable_const_mul
        y).comp hι))
      { toFun := fun a => B a b, map_add' := fun _ _ => by simp, map_smul' := fun _ _ => by simp }
  have hO := UpperTheory.irreducible_hermitian_form_unique μA π hI B hh hp hinv hm x₀ x₀ u₀ x₀
  simp only [key, hc', mul_assoc]; rw [integral_const_mul]; simp only [← mul_assoc] at hO ⊢
  rw [hO, show pet μ 𝓕 u (f x₀) = B u₀ x₀ from hu₀ x₀, hh x₀ u₀, star_star]
  have hxx : star (B x₀ x₀) = B x₀ x₀ := (hh x₀ x₀).symm; rw [hxx]; ring

theorem schurStep_k : Tools_k → SchurStep_k := by
  intro T E _ _ _ B n d X W M χX χW om P hn e e' he he' U hU f₀ hf₀ φ hφ hS ν hν φf hfin μA hμA
  obtain ⟨V, _, _, _, ρ, i, j, x₀, hirr, hi, hj, hjU, hA, hR⟩ := hS
  have C := T.cpt _ E (cj E) B n X n 0 P.base (Or.inl P.herm) (by simp)
  have D := decomp_k T _ E (cj E) B n X P.base P.herm ∅
  have := C.lc; have := C.sc; have := C.t2; have := C.cnt
  have : BorelSpace (UA (cj E) X.J) := ⟨rfl⟩
  have hHaar : M.μ.IsHaarMeasure := P.good.haar; have := C.right _ hHaar
  have : CompactSpace (gInf (cj E) X) := isCompact_iff_compactSpace.1 D.2.1
  have : IsFiniteMeasure μA := inferInstance
  have : Nontrivial V := ⟨x₀, 0, fun h => hφ (by rw [← hj, h, map_zero])⟩
  let p : gInf (cj E) X →* infU E n :=
    { toFun := fun x => ⟨e.symm x.1, (he.inf _).1 (by simp [x.2])⟩,
      map_one' := Subtype.ext (by simp), map_mul' := fun _ _ => Subtype.ext (by simp) }
  have hpe : ∀ x, e (p x).1 = x.1 := fun _ => e.apply_symm_apply _
  let π : gInf (cj E) X →* Module.End ℂ V := ρ.comp p
  have hI : ∀ W' : Submodule ℂ V, (∀ g, ∀ w ∈ W', π g w ∈ W') → W' = ⊥ ∨ W' = ⊤ := fun W' h => by
    let S : Subrepresentation ρ := ⟨W', fun k v hv => by
      have hps : p ⟨e k.1, (he.inf _).2 k.2⟩ = k := Subtype.ext (e.symm_apply_apply _)
      simpa [π, hps] using h ⟨e k.1, (he.inf _).2 k.2⟩ v hv⟩
    rcases hirr.eq_bot_or_eq_top S with h1 | h1
    exacts [.inl (congrArg Subrepresentation.toSubmodule h1), .inr (congrArg Subrepresentation.toSubmodule h1)]
