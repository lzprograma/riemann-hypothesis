  JT →* Module.End ℂ (thetaSubF σ JS JT ξ₀ B.ψ)} {s : Matrix (IxF F nS nT) (IxF F nS nT) ℂ}
theorem infinite_norm_one_k (C : Ctx_k σ B JS JT ξ₀ θ ι) : {t : E | t * σ t = 1}.Infinite
  :=
  UpperTheory.Reformulated.B.InfiniteNormOneField.infinite_norm_one_k C
theorem det_kron_k (C : Ctx_k σ B JS JT ξ₀ θ ι) {g : GAF σ JS} {h : GAF σ JT} {a b}
    (ha : IsRatF σ JS g a) (hb : IsRatF σ JT h⁻¹ b) :
    (b ⊗ₖ aᵀ).det * σ (b ⊗ₖ aᵀ).det = 1 ∧
      (b ⊗ₖ aᵀ).det * σ (b ⊗ₖ aᵀ - 1).det = (-1) ^ Fintype.card (Fin nT × Fin nS) * (b ⊗ₖ aᵀ - 1).det := by
  have hu := isUnit_iff_ne_zero.2 C.hS.2
