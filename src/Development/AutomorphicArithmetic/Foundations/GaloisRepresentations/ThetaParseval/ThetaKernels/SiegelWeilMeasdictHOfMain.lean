theorem _root_.PositivityTheory.RgEis.Hd.eisBL_k : GlobalTheory.ThK.Dbl.EisBL_k :=
  fun F E _ _ _ _ _ σ B n Y _ _ hB hn _ => eisBLW_k F E σ B n Y hB hn
theorem _root_.PositivityTheory.SiegelWeilFormula.Khead.eisStrong_of_k :
    _root_.GlobalTheory.ThK.Dbl.EisBL_k → PositivityTheory.SiegelWeilFormula.EisStrong_k :=
  fun _ F E _ _ _ _ _ σ d _ s₁ f hf s₀ => eisWk_k F E σ d s₁ f hf s₀
