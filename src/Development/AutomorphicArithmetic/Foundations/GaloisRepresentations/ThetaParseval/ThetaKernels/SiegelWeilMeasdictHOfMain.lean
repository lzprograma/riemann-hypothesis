variable {d : SD_k σ} {η : E} {hOf : nA σ d.Y d.b → HeckeCharacterZeroLocus.SiegelWeilU.HermR (AF F) σ d.n}
theorem mem_ratHerm_k {S : HeckeCharacterZeroLocus.SiegelWeilU.HermR (AF F) σ d.n} :
    S ∈ MeasP.ratHerm F E σ d.n ↔ ∃ M : Matrix (Fin d.n) (Fin d.n) E, incM F M = (S.1 : Mx F E d.n d.n) := by
  simp only [MeasP.ratHerm, AddSubgroup.mem_comap, AddMonoidHom.mem_range]
  rfl
def ratE_k (hne : η ≠ 0)
    (hof : ∀ β, β.1 = -(incM F (Matrix.scalar (Fin d.n) η) * ((hOf β).1 : Mx F E d.n d.n)ᵀ))
    (herm : ∀ i j, σ (η * d.A.J j i) = η * d.A.J i j) :
    MeasP.ratHerm F E σ d.n ≃ d.nF_ where
  toFun S := ⟨(hEq_k hOf hne hof herm).symm S.1, by
    rw [mem_nF_iff]
    obtain ⟨M, hM⟩ := mem_ratHerm_k.1 S.2
    refine ⟨-(η • Mᵀ), ?_⟩
    show -(inclR (F := F) (AF F) η • ((S.1).1 : Mx F E d.n d.n)ᵀ) = _
    rw [← hM]
    ext a b
    simp [incM, Matrix.map_apply, map_mul, map_neg]⟩
  invFun γ := ⟨hEq_k hOf hne hof herm γ.1, by
    rw [mem_ratHerm_k]
    obtain ⟨T, hT⟩ := (mem_nF_iff γ.1).1 γ.2
    refine ⟨-(η⁻¹ • Tᵀ), ?_⟩
    show _ = ((hOf γ.1).1 : Mx F E d.n d.n)
    rw [hOf_val_k hOf hne hof, hT]
    ext a b
    simp [incM, Matrix.map_apply, map_mul, map_neg]⟩
  left_inv S := Subtype.ext ((hEq_k hOf hne hof herm).apply_symm_apply S.1)
  right_inv γ := Subtype.ext ((hEq_k hOf hne hof herm).symm_apply_apply γ.1)
end Rat
theorem meas_hOf_k {d : SD_k σ} {R : RD_k d} {x : d.G} {t u : d.Gn} {T : d.nF_} {η : E}
    {T₀ : Matrix (Fin d.n) (Fin d.n) E} {hOf : d.nA_ → HeckeCharacterZeroLocus.SiegelWeilU.HermR (AF F) σ d.n}
    {θ : InfinitePlace F → (HeckeCharacterZeroLocus.SiegelWeilU.Ainf F ⊗[F] E →+* ℂ)} {fr : InfinitePlace F → GL
        (Fin d.m) ℂ}
    {g : InfinitePlace F → d.Gnc} (hR : KWhit.Rel_k d R x t u T η T₀ hOf θ fr g)
    {nb : d.nA_ → d.G} {lam : Measure d.nA_} {𝓖 : Set d.nA_}
    (hc : d.CD nb lam 𝓖) :
    MeasurableEmbedding hOf ∧ (lam.map hOf).IsAddHaarMeasure ∧
      IsAddFundamentalDomain (MeasP.ratHerm F E σ d.n) (hOf '' 𝓖) (lam.map hOf) ∧ lam.map hOf (hOf '' 𝓖) = 1 := by
  have hσ := kfour.sigma_sigma_of_good_k d.ok.good
  obtain ⟨-, -, -, hbo⟩ := nA_top hσ d.ok.frame
  have := hbo
  have : BorelSpace (HeckeCharacterZeroLocus.SiegelWeilU.HermR (AF F) σ d.n) := ⟨rfl⟩
  have : lam.IsAddHaarMeasure := hc.2.1
  have hfd : IsAddFundamentalDomain d.nF_ 𝓖 lam := hc.2.2.1
  have h1 : lam 𝓖 = 1 := hc.2.2.2
  let e := hEq_k hOf hR.ne hR.hof hR.herm
  let eM := e.toHomeomorph.toMeasurableEquiv
  have hemb : MeasurableEmbedding hOf := eM.measurableEmbedding
  refine ⟨hemb, ?_, ?_, ?_⟩
  · exact e.toAddEquiv.isAddHaarMeasure_map lam e.continuous e.symm.continuous
  · refine hfd.image_of_equiv eM.toEquiv (eM.measurePreserving_symm lam).quasiMeasurePreserving
      (ratE_k hR.ne hR.hof hR.herm) ?_
    intro S β
    show e (e.symm S.1 + β) = S.1 + e β
    rw [map_add (f := _), ContinuousAddEquiv.apply_symm_apply]
  · rw [hemb.map_apply, Set.preimage_image_eq _ hemb.injective]; exact h1
end PositivityTheory.SiegelWeilFormula.MeasD
