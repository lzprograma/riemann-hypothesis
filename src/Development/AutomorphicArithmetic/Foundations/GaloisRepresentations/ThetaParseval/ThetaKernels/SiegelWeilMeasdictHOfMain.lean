  obtain ⟨C, hC⟩ := _root_.GlobalTheory.CompanionTheory.EisTerm.flat_norm_le_height_rpow K a hKc hH hpos χ s₁ f hf
  obtain ⟨σ₀, hσ⟩ := godement_sum_w_k hB hb hK hH
