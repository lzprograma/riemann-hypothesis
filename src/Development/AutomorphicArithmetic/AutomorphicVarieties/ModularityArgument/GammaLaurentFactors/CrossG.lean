private theorem unr_of {a b c : kˣ →* ℂˣ} (ha : IsUnram a) (hb : IsUnram b) (h : ∀ x, a x = 1 → b x = 1 → c x = 1) :
    IsUnram c := fun x hx => h x (ha x hx) (hb x hx)

