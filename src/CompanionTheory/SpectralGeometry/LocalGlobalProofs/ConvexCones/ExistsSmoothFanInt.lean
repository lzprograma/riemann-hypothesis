  obtain ⟨φ, h₁, h₂, -, -⟩ := _root_.GlobalTheory.CompanionTheory.Ar.Fan.SmoothRefinement.exists_smooth_refinement ℤ id 0 _root_.GlobalTheory.CompanionTheory.Ar.Fan.CMOrd.int g (vorFun ℤ g)
