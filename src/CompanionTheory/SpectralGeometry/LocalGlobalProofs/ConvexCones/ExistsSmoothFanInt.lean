        (∀ i, IsPrim bar (⟨δ i, h.mem i⟩ : balForms bar (R k))) →
        ∃ e : (R k) ≃ₗ[O] (R k), ∀ i, pull e.toLinearMap (δ i) ∈ T := fun k => by
    haveI := (hR k).2.1
    exact perModule bar φ (R k) (hφ (R k) (hR k).2.2)
